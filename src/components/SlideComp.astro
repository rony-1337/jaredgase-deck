---
// Code-built slide figures: layered pieces positioned and animated in code
// instead of a flat exported image. Each piece nests three layers so the
// effects never fight over one transform:
//   [data-reveal] wrapper  -> staggered entrance
//   [data-parallax] wrapper -> scroll drift (driven by ParallaxScript)
//   .float img              -> gentle idle bob (CSS keyframes)
// Compositions are authored per project; this set belongs to salesforce-to-iep.

import { readFileSync, readdirSync } from "node:fs";
import { join } from "node:path";

interface Props {
  name: string;
}
const { name } = Astro.props;
const base = "/img/projects/salesforce-to-iep";
const aiBase = "/img/projects/ai-native";
const cBase = "/img/projects/concierge";
const jdBase = "/img/about-jd";
const hiaBase = "/img/projects/human-intervention-agent";
const vepBase = "/img/about-work/01_intuits-platform";
const pmBase = "/img/about-work/03_platform-mindset";

// concierge slide 4 (flowdeck): every node of 04_e2e-concierge-flow.svg as a
// card. l/t/w/h are % of the diagram's 6288x2327 viewBox; dx/dy are the offset
// (in container-width / container-height %) back to a shared stack anchor so
// the cards start piled and fan out to their real positions in reading order.
// r is a small pile-jitter rotation. k: r=round, b=box, d=diamond.
const flowNodes = [
  {l:3.37,t:13.94,w:4.71,h:12.72,k:"r",dx:2.63,dy:12.06,r:-8.8},
  {l:10.81,t:15.99,w:3.18,h:8.59,k:"b",dx:-4.81,dy:10.01,r:-6.6},
  {l:17.17,t:15.96,w:3.20,h:8.65,k:"d",dx:-11.17,dy:10.04,r:-4.4},
  {l:23.54,t:16.16,w:3.18,h:8.59,k:"b",dx:-17.54,dy:9.84,r:-2.2},
  {l:23.54,t:29.05,w:3.18,h:8.59,k:"b",dx:-17.54,dy:-3.05,r:0.0},
  {l:29.87,t:16.16,w:3.18,h:8.59,k:"b",dx:-23.87,dy:9.84,r:2.2},
  {l:29.87,t:29.05,w:3.18,h:8.59,k:"b",dx:-23.87,dy:-3.05,r:4.4},
  {l:36.22,t:16.13,w:3.20,h:8.65,k:"d",dx:-30.22,dy:9.87,r:6.6},
  {l:36.22,t:29.03,w:3.20,h:8.65,k:"d",dx:-30.22,dy:-3.03,r:8.8},
  {l:36.23,t:41.94,w:3.18,h:8.59,k:"b",dx:-30.23,dy:-15.94,r:-8.8},
  {l:42.59,t:15.99,w:3.18,h:8.59,k:"b",dx:-36.59,dy:10.01,r:-6.6},
  {l:48.94,t:15.96,w:3.20,h:8.65,k:"d",dx:-42.94,dy:10.04,r:-4.4},
  {l:48.95,t:29.05,w:3.18,h:8.59,k:"b",dx:-42.95,dy:-3.05,r:-2.2},
  {l:55.30,t:15.96,w:3.20,h:8.65,k:"d",dx:-49.30,dy:10.04,r:0.0},
  {l:55.31,t:29.05,w:3.18,h:8.59,k:"b",dx:-49.31,dy:-3.05,r:2.2},
  {l:55.30,t:41.92,w:3.20,h:8.65,k:"d",dx:-49.30,dy:-15.92,r:4.4},
  {l:61.67,t:15.99,w:3.18,h:8.59,k:"b",dx:-55.67,dy:10.01,r:6.6},
  {l:61.66,t:29.03,w:3.20,h:8.65,k:"d",dx:-55.66,dy:-3.03,r:8.8},
  {l:61.67,t:41.94,w:3.18,h:8.59,k:"b",dx:-55.67,dy:-15.94,r:-8.8},
  {l:68.03,t:15.99,w:3.18,h:8.59,k:"b",dx:-62.03,dy:10.01,r:-6.6},
  {l:68.03,t:29.05,w:3.18,h:8.59,k:"b",dx:-62.03,dy:-3.05,r:-4.4},
  {l:68.03,t:41.94,w:3.18,h:8.59,k:"b",dx:-62.03,dy:-15.94,r:-2.2},
  {l:74.40,t:15.99,w:3.18,h:8.59,k:"b",dx:-68.40,dy:10.01,r:0.0},
  {l:80.75,t:15.96,w:3.20,h:8.65,k:"d",dx:-74.75,dy:10.04,r:2.2},
  {l:80.76,t:29.87,w:3.18,h:8.59,k:"b",dx:-74.76,dy:-3.87,r:4.4},
  {l:87.12,t:15.99,w:3.18,h:8.59,k:"b",dx:-81.12,dy:10.01,r:6.6},
  {l:93.48,t:15.99,w:3.18,h:8.59,k:"r",dx:-87.48,dy:10.01,r:8.8},
  {l:3.37,t:53.98,w:4.71,h:12.72,k:"r",dx:2.63,dy:-27.98,r:-8.8},
  {l:10.80,t:55.37,w:3.20,h:8.65,k:"d",dx:-4.80,dy:-29.37,r:-6.6},
  {l:10.81,t:68.24,w:3.18,h:8.59,k:"b",dx:-4.81,dy:-42.24,r:-4.4},
  {l:17.18,t:55.39,w:3.18,h:8.59,k:"b",dx:-11.18,dy:-29.39,r:-2.2},
  {l:23.54,t:55.39,w:3.18,h:8.59,k:"b",dx:-17.54,dy:-29.39,r:0.0},
  {l:23.54,t:68.24,w:3.18,h:8.59,k:"b",dx:-17.54,dy:-42.24,r:2.2},
  {l:23.54,t:81.09,w:3.18,h:8.59,k:"b",dx:-17.54,dy:-55.09,r:4.4},
  {l:55.31,t:54.83,w:3.18,h:8.59,k:"b",dx:-49.31,dy:-28.83,r:6.6},
];

// concierge slide 5: the two single-path logos, read raw so the client can
// sample + interpolate their outlines into a genuine shape morph
const firstPathD = (svg: string) => (svg.match(/\sd="([^"]+)"/) || [, ""])[1];
const crmMorph =
  name === "crm"
    ? {
        sf: firstPathD(readFileSync(join(process.cwd(), "public/img/projects/concierge/05_salesforce-logo.svg"), "utf-8")),
        iep: firstPathD(readFileSync(join(process.cwd(), "public/img/projects/concierge/05_iep-logo.svg"), "utf-8")),
      }
    : { sf: "", iep: "" };

// concierge slide 6: two archetype circles with tag pills
const conciergeDuo = [
  { img: `${cBase}/06_in-person-concierge.png`, tag: `${cBase}/06_in-person-concierge-tag.svg`, alt: "In-person Concierge", tw: 229, th: 56 },
  { img: `${cBase}/06_vertual-concierge.png`, tag: `${cBase}/06_virtual-concierge-tag.svg`, alt: "Virtual Concierge", tw: 207, th: 56 },
];

// the five BU bars that grow before merging into one (heights vary)
const chartBars = ["58%", "80%", "64%", "90%", "72%"];

// panel deck · slide 1: the four business units feeding into VEP. Each arrow
// is pre-oriented for its card, so only the draw direction differs.
// `s` is an optical scale: the lockups have equal bounding-box heights but
// read at different sizes, so each gets a hand-tuned multiplier.
const vepUnits = [
  { logo: `${vepBase}/01_turbotax-logo.svg`, alt: "TurboTax", w: 238, h: 50, s: 1.25, arrow: `${vepBase}/01_arrow_style01.svg`, aw: 316, ah: 269, k: "a" },
  { logo: `${vepBase}/01_quickbooks-logo.svg`, alt: "QuickBooks", w: 298, h: 56, s: 1.5, arrow: `${vepBase}/01_arrow_style02.svg`, aw: 71, ah: 152, k: "b" },
  { logo: `${vepBase}/01_mailchimp-logo.svg`, alt: "Mailchimp", w: 274, h: 56, s: 1.4, arrow: `${vepBase}/01_arrow_style03.svg`, aw: 105, ah: 178, k: "c" },
  { logo: `${vepBase}/01_creditkarma-logo.svg`, alt: "Credit Karma", w: 304, h: 50, s: 1.5, arrow: `${vepBase}/01_arrow_style04.svg`, aw: 271, ah: 245, k: "d" },
];

// Illustrator exports carry generic .st1/.st2/... classes in an internal
// <style> block. Inlined SVGs share the page, so those styles are global and
// collide across files; scope each stylesheet to its wrapper before inlining.
const scopeSvgStyles = (svg: string, scope: string) =>
  svg.replace(/<style([^>]*)>([\s\S]*?)<\/style>/g, (_all, attrs, css) => {
    const scoped = css.replace(/\.st(\d+)\b/g, `${scope} .st$1`);
    return `<style${attrs}>${scoped}</style>`;
  });

// grandpa is inlined (not an <img>) so CSS can animate the parts inside it,
// like the .gp-eyes group for the blink
const grandpaSvg =
  name === "grandpa"
    ? readFileSync(join(process.cwd(), "public/img/projects/salesforce-to-iep/01_grandpa-simpsons.svg"), "utf-8")
    : "";

// the capability map is inlined too; its redline annotations are authored as
// grouped layers (#redline_1 through #redline_6), each marker + number +
// connector moving as one unit
const capmapSvg =
  name === "capmap"
    ? scopeSvgStyles(
        readFileSync(join(process.cwd(), "public/img/projects/salesforce-to-iep/06_e2e-capability-map.svg"), "utf-8"),
        ".capmap-svg",
      )
    : "";

// the implementation redlining spec, inlined and ready for the same draw-in
// treatment once its annotations are grouped (redline_1..N) in the source
const redliningSvg =
  name === "redlining"
    ? scopeSvgStyles(
        readFileSync(join(process.cwd(), "public/img/projects/salesforce-to-iep/10_redlining.svg"), "utf-8"),
        ".redlining-svg",
      )
    : "";

// panel deck · slides 2 + 4: inlined so their internals can animate. The bar
// chart's merged shape is tagged .bc-merged; the ecosystem's spokes, dots,
// ring, and logo groups are tagged eco-*.
const vepChartSvg =
  name === "vepchart"
    ? scopeSvgStyles(
        readFileSync(join(process.cwd(), "public/img/about-work/02_unique/02_bar-chart.svg"), "utf-8"),
        ".vepchart-svg",
      )
    : "";

const ecosystemSvg =
  name === "ecosystem"
    ? scopeSvgStyles(
        readFileSync(join(process.cwd(), "public/img/about-work/04_ecosystem/04_vep-ecosystem.svg"), "utf-8"),
        ".ecosystem-svg",
      )
    : "";

// concierge slide 4: the ultra-wide E2E flow, inlined so it can scale cleanly
const flowSvg =
  name === "flow"
    ? scopeSvgStyles(
        readFileSync(join(process.cwd(), "public/img/projects/concierge/04_e2e-concierge-flow.svg"), "utf-8"),
        ".flow-svg",
      )
    : "";

const personas = [
  { img: `${base}/02_persona_partner-outsourced.png`, cap: "Partner outsourced" },
  { img: `${base}/02_persona_intuit-badged.png`, cap: "Intuit badged" },
  { img: `${base}/02_persona_tier2-lead-sme.png`, cap: "Tier 2/Lead/SME" },
];

const research = [
  { img: `${base}/04a_FMH.png`, alt: "Follow Me Home session recording" },
  { img: `${base}/04b_service-design-blueprint.png`, alt: "Service design blueprint" },
  { img: `${base}/04c_experience-design-blueprint.png`, alt: "Experience design blueprint" },
  { img: `${base}/04d_journey-map-key.svg`, alt: "Journey map key" },
];

const framework = [
  { tone: "gray", label: "No enhancement", cap: "Existing IEP capabilities ready to use" },
  { tone: "blue", label: "Enhancement", cap: "Needed strengthening for durability" },
  { tone: "green", label: "Net new", cap: "Missing capabilities to be designed and built" },
];

// the impact deck: every screen in 11_deck/, cycled like a shuffled pile
const deckImgs =
  name === "deck"
    ? readdirSync(join(process.cwd(), "public/img/projects/salesforce-to-iep/11_deck"))
        .filter((f) => /\.(png|jpe?g|webp)$/i.test(f))
        .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
        .map((f) => `${base}/11_deck/${encodeURIComponent(f)}`)
    : [];

// --- ai-native compositions ---------------------------------------------
// slide 2: two expert archetypes, circular photo + tag pill
const archetypes = [
  { img: `${aiBase}/02_archetype_product-expert.png`, tag: `${aiBase}/02_product-expert-tag.svg`, alt: "TT Product Expert", tw: 210, th: 56 },
  { img: `${aiBase}/02_archetype_domain-expert.png`, tag: `${aiBase}/02_domain-expert-tag.svg`, alt: "TT Domain Expert", tw: 212, th: 56 },
];

// slide 3: work comes into IEP. Icons ring a browser window, each with an
// arrow pointing inward. pos drives placement + arrow flip (see CSS); arrow
// picks the style: "02" is the wide down-right curve, "01" the tall down-left.
const arrowSrc = {
  "01": { src: `${aiBase}/03_arrow-style_01.svg`, w: 92, h: 228 },
  "02": { src: `${aiBase}/03_arrow-style_02.svg`, w: 202, h: 125 },
} as const;

const workIcons = [
  { icon: `${aiBase}/03_taxes.svg`, alt: "Taxes", w: 131, h: 133, pos: "tl", arrow: "02" },
  { icon: `${aiBase}/03_shopping-cart.svg`, alt: "Shopping cart", w: 131, h: 118, pos: "tr", arrow: "01" },
  { icon: `${aiBase}/03_investigation.svg`, alt: "Account lookup", w: 117, h: 99, pos: "br", arrow: "02" },
  { icon: `${aiBase}/03_documents.svg`, alt: "Documents", w: 109, h: 132, pos: "bc", arrow: "01" },
  { icon: `${aiBase}/03_account-lookup.svg`, alt: "Case work", w: 131, h: 98, pos: "bl", arrow: "02" },
] as const;
---

{name === "grandpa" && (
  <div class="comp comp-grandpa">
    <div class="pc pc-cloud" data-reveal style="--reveal-delay:220ms">
      <div data-parallax data-speed-x="34" data-speed-y="48">
        <img class="cloud-drift" src={`${base}/03_sfdc-logo.svg`} alt="" width="143" height="100" />
      </div>
    </div>
    <div data-reveal data-from="right" style="--reveal-delay:60ms">
      <div class="grandpa-shake gp-svg" role="img" aria-label="Angry old man yelling at the Salesforce cloud">
        <Fragment set:html={grandpaSvg} />
      </div>
    </div>
  </div>
)}

{name === "personas" && (
  <div class="comp comp-personas">
    <p class="personas-head" data-reveal>Type of product experts ...</p>
    <div class="personas-row" data-reveal style="--reveal-delay:120ms">
      {personas.map((p, i) => (
        <figure class="persona">
          <div data-parallax data-speed-x={String(6 - i * 6)} data-speed-y={String(10 + i * 6)}>
            <span class="persona-hov">
              <img class={`float fl-${["a", "b", "c"][i]}`} src={p.img} alt={p.cap} width="594" height="594" />
            </span>
          </div>
          <figcaption>{p.cap}</figcaption>
        </figure>
      ))}
    </div>
  </div>
)}

{name === "goals" && (
  <div class="comp comp-goals" data-reveal>
    <div class="goal-side">
      <div class="goal-logo" data-parallax data-speed-x="8" data-speed-y="18">
        <span class="g-in g-logo-sfdc">
          <img class="float fl-a" src={`${base}/03_sfdc-logo.svg`} alt="Salesforce" width="143" height="100" />
        </span>
      </div>
      <span class="g-in g-laptop-sfdc">
        <img class="goal-laptop" src={`${base}/03_sfdc-laptop.svg`} alt="Salesforce workspace on a laptop" width="400" height="223" />
      </span>
    </div>
    <div class="goal-arrow">
      <div data-parallax data-speed-x="-14" data-speed-y="0">
        <span class="g-in g-arrow">
          <img src={`${base}/03_arrow.svg`} alt="" width="149" height="89" />
        </span>
      </div>
    </div>
    <div class="goal-side">
      <div class="goal-logo" data-parallax data-speed-x="-8" data-speed-y="14">
        <span class="g-in g-logo-iep">
          <img class="float fl-b" src={`${base}/03_iep-logo.svg`} alt="IEP" width="100" height="101" />
        </span>
      </div>
      <span class="g-in g-laptop-iep">
        <img class="goal-laptop" src={`${base}/03_iep-laptop.svg`} alt="IEP workspace on a laptop" width="400" height="223" />
      </span>
    </div>
  </div>
)}

{name === "research" && (
  <div class="comp comp-research" data-reveal>
    {research.map((r, i) => (
      <figure class={`research-tile rt-${i + 1}`} style={`--d:${0.1 + i * 0.15}s`}>
        <img src={r.img} alt={r.alt} loading="lazy" />
      </figure>
    ))}
  </div>
)}

{name === "capmap" && (
  <div class="comp comp-capmap" data-reveal>
    <div class="capmap-svg" role="img" aria-label="E2E capability map built on the IDEAL framework">
      <Fragment set:html={capmapSvg} />
    </div>
  </div>
)}

{name === "assist" && (
  <div class="comp comp-assist" data-reveal>
    <div class="assist-crop">
      <img
        src={`${base}/08_ai-powered-expert-support.png`}
        alt="Intuit Assist summarizing a support request inside the browser"
        width="2772"
        height="1744"
        loading="lazy"
      />
    </div>
  </div>
)}

{name === "redlining" && (
  <div class="comp comp-redlining" data-reveal>
    <div class="redlining-svg" role="img" aria-label="Redlined spec of the AI support-request card">
      <Fragment set:html={redliningSvg} />
    </div>
  </div>
)}

{name === "deck" && (
  <div class="comp comp-deck" data-reveal>
    <div class="deck-stack" data-deck>
      {deckImgs.map((src, i) => (
        <figure class="deck-card">
          <img
            src={src}
            alt={`IEP screen ${i + 1} of ${deckImgs.length}`}
            width="1366"
            height="768"
            loading={i < 3 ? "eager" : "lazy"}
          />
        </figure>
      ))}
    </div>
  </div>
)}

{name === "framework" && (
  <div class="comp comp-framework" data-reveal>
    {framework.map((f, i) => (
      <div class="fw-row" style={`--d:${0.9 + i * 0.55}s`}>
        <span class={`fw-pill fw-${f.tone} float fl-${["a", "b", "c"][i]}`}>{f.label}</span>
        <span class="fw-cap">{f.cap}</span>
      </div>
    ))}
  </div>
)}

{name === "conclusion" && (
  <div class="comp comp-conclusion">
    <div class="pc cc-table" data-reveal>
      <div data-parallax data-speed-x="0" data-speed-y="6">
        <img src={`${base}/12a_conclusion_table.svg`} alt="Customer timeline card" width="516" height="658" />
      </div>
    </div>
    <div class="pc cc-expert2" data-reveal style="--reveal-delay:180ms">
      <div data-parallax data-speed-x="-10" data-speed-y="20">
        <img class="float fl-a" src={`${base}/12d_conclusion_expert2.svg`} alt="" width="190" height="190" />
      </div>
    </div>
    <div class="pc cc-ctas" data-reveal data-from="right" style="--reveal-delay:300ms">
      <div data-parallax data-speed-x="-16" data-speed-y="10">
        <img class="float fl-b" src={`${base}/12b_conclusion_CTAs.svg`} alt="" width="314" height="212" />
      </div>
    </div>
    <div class="pc cc-expert1" data-reveal style="--reveal-delay:240ms">
      <div data-parallax data-speed-x="12" data-speed-y="16">
        <img class="float fl-c" src={`${base}/12c_conclusion_expert1.svg`} alt="" width="190" height="190" />
      </div>
    </div>
    <div class="pc cc-star1" data-reveal style="--reveal-delay:420ms">
      <div data-parallax data-speed-x="10" data-speed-y="24">
        <img class="float fl-b" src={`${base}/12f_conclusion_star1.svg`} alt="" width="85" height="92" />
      </div>
    </div>
    <div class="pc cc-star2" data-reveal style="--reveal-delay:480ms">
      <div data-parallax data-speed-x="-12" data-speed-y="18">
        <img class="float fl-c" src={`${base}/12g_conclusion_star2.svg`} alt="" width="85" height="92" />
      </div>
    </div>
    <div class="pc cc-arrow" data-reveal style="--reveal-delay:360ms">
      <div data-parallax data-speed-x="8" data-speed-y="12">
        <img src={`${base}/12e_conclusion_arrow.svg`} alt="" width="281" height="92" />
      </div>
    </div>
  </div>
)}

{name === "hijared" && (
  <div class="comp comp-hijared">
    <figure class="hi-portrait" data-reveal>
      <div data-parallax data-speed-x="0" data-speed-y="10">
        <img src="/img/jared.jpg" alt="Jared Gase" width="600" height="600" />
      </div>
    </figure>
  </div>
)}

{name === "vepbreakdown" && (
  <div class="comp comp-vepbreakdown">
    <div class="vb-vep" data-reveal>
      <div data-parallax data-speed-x="0" data-speed-y="10">
        <img class="float fl-a" src={`${vepBase}/01_vep-logo.svg`} alt="VEP" width="342" height="122" />
      </div>
    </div>
    {vepUnits.map((u, i) => (
      <span class={`vb-arrow vb-arr-${u.k}`} data-reveal style={`--reveal-delay:${420 + i * 160}ms`}>
        <img src={u.arrow} alt="" width={u.aw} height={u.ah} />
      </span>
    ))}
    <div class="vb-cards">
      {vepUnits.map((u, i) => (
        <div class="vb-card" data-reveal style={`--reveal-delay:${120 + i * 110}ms;--s:${u.s}`}>
          <img src={u.logo} alt={u.alt} width={u.w} height={u.h} />
        </div>
      ))}
    </div>
  </div>
)}

{name === "vepchart" && (
  <div class="comp comp-vepchart">
    <div class="vepchart-svg" role="img" aria-label="VEP works vertically across teams and horizontally across every business unit">
      <Fragment set:html={vepChartSvg} />
    </div>
    <div class="bc-bars" aria-hidden="true">
      {chartBars.map((h) => <span class="bc-bar" style={`--h:${h}`}></span>)}
    </div>
  </div>
)}

{name === "ecosystem" && (
  <div class="comp comp-ecosystem">
    <div class="ecosystem-svg" role="img" aria-label="VEP at the center of an ecosystem of Intuit business units">
      <Fragment set:html={ecosystemSvg} />
    </div>
  </div>
)}

{name === "platformmindset" && (
  <div class="comp comp-platformmindset">
