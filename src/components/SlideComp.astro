  .rt-4 img { object-fit: contain; padding: clamp(var(--s-3), 1.5vw, var(--s-5)); }
  .research-tile:not(.is-zoom):hover { transform: scale(1.03); box-shadow: var(--shadow-lift); }
  .research-tile.is-zoom {
    transform: scale(2.04); z-index: 6; cursor: zoom-out;
    box-shadow: var(--shadow-lift);
  }

  /* 08 · AI-powered support: one gray canvas (like the deck) zoomed hard
     into the browser's top-right corner. The frame's rounded corner sits
     inset with a gray gap at the top and right; the rest bleeds off the
     left and bottom, cropping the support-request card mid-list. */
  .assist-crop {
    aspect-ratio: 5 / 4; overflow: clip; position: relative;
    border-radius: var(--radius); background: #fff;
    box-shadow: var(--shadow);
  }
  .assist-crop img {
    position: absolute; top: 7.8%; right: 7.4%;
    width: 237%; max-width: none; height: auto;
  }

  /* 10 · implementation redlining: bare, centered, sized by the column */
  .comp-redlining { max-width: 40rem; margin-inline: auto; }

  /* 12 · impact deck, matching the reference gif: straight cards, each one
     behind peeking slightly lower and a touch smaller. The shuffle lifts the
     top card straight up, then settles it down onto the back of the pile. */
  .comp-deck { padding: 14% 2% 5%; }
  .deck-stack { position: relative; aspect-ratio: 1366 / 768; }
  .deck-card {
    position: absolute; inset: 0; margin: 0;
    border-radius: var(--radius-s); overflow: clip;
    border: 1px solid var(--line); background: #fff;
    box-shadow: 0 18px 44px -22px rgba(17, 21, 28, 0.4);
    transform: translateY(calc(var(--depth, 0) * 14px)) scale(calc(1 - var(--depth, 0) * 0.025));
    transition: transform 0.6s var(--ease);
    will-change: transform;
  }
  .deck-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .deck-card.is-out {
    transform: translateY(-46%) scale(0.99);
  }
  /* hovering pauses the shuffle; grow the screen you paused on */
  .deck-card { transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease); }
  .deck-stack:hover .deck-card.is-front:not(.is-out) {
    transform: translateY(0) scale(1.07);
    box-shadow: 0 26px 60px -24px rgba(17, 21, 28, 0.5);
  }

  /* 05 · capability framework, built entirely in code */
  .comp-framework {
    display: grid; gap: clamp(var(--s-6), 5vh, var(--s-10));
    justify-items: center; padding: clamp(var(--s-5), 4vh, var(--s-8)) 0;
  }
  .fw-row { display: grid; gap: var(--s-3); justify-items: center; }
  .fw-pill {
    display: inline-block;
    padding: 0.3em 1.1em; border-radius: 10px;
    font-family: var(--font-sans); font-weight: 800;
    font-size: clamp(1.05rem, 0.9rem + 0.9vw, 1.5rem);
    letter-spacing: 0.04em; text-transform: uppercase; color: #fff;
    box-shadow: 0 10px 26px -14px rgba(17, 21, 28, 0.45);
  }
  .fw-gray { background: #90959c; }
  .fw-blue { background: #2b78d4; }
  .fw-green { background: #4aa32a; }
  .fw-cap { font-style: italic; font-size: var(--t-small); color: var(--ink-soft); text-align: center; }

  /* 12 · conclusion collage (positions match the example layout) */
  .comp-conclusion { aspect-ratio: 5 / 4; }
  .cc-table { left: 20%; top: 5%; width: 50%; z-index: 1; }
  .cc-expert2 { left: 62%; top: 7%; width: 16%; z-index: 3; }
  .cc-ctas { left: 56%; top: 46%; width: 32%; z-index: 3; }
  .cc-expert1 { left: 14%; top: 60%; width: 16%; z-index: 2; }
  .cc-star1 { left: 8%; top: 5%; width: 7%; }
  .cc-star2 { left: 88%; top: 82%; width: 7%; }
  .cc-arrow { left: 3%; top: 80%; width: 21%; }

  /* panel deck · hello: circular portrait inside a thick accent ring */
  .comp-hijared { display: grid; place-items: center; }
  .hi-portrait { margin: 0; width: min(34vh, 20rem); }
  .hi-portrait img {
    display: block; width: 100%; aspect-ratio: 1; object-fit: cover;
    border-radius: 50%;
    border: clamp(7px, 0.9vw, 13px) solid var(--accent);
  }

  /* panel deck · slide 1: business units feeding into VEP */
  /* shorter than the source layout so the headline, the art, and an open
     "Additional info" accordion all sit on one screen without crowding */
  .comp-vepbreakdown {
    position: relative; aspect-ratio: 16 / 8;
    max-width: 92%; margin-inline: auto;
  }
  .comp-vepbreakdown img { display: block; width: 100%; height: auto; }
  .vb-vep { position: absolute; left: 39.5%; top: 15%; width: 21%; z-index: 2; }
  .vb-arrow { position: absolute; z-index: 3; }
  .vb-arr-a { left: 19%; top: 32%; width: 19%; }
  .vb-arr-b { left: 40%; top: 37%; width: 5%; }
  .vb-arr-c { left: 56%; top: 37%; width: 6.5%; }
  .vb-arr-d { left: 65%; top: 29%; width: 17%; }
  .vb-cards {
    position: absolute; left: 2%; right: 2%; bottom: 4%;
    display: flex; gap: 2.4%; z-index: 1;
  }
  .vb-card {
    flex: 1; display: grid; place-items: center;
    aspect-ratio: 16 / 10; padding: 0;
    background: #fff; border: 2px solid var(--navy);
    border-radius: 14px;
  }
  /* Equal bounding-box heights read unevenly, so each lockup carries an
     optical scale (--s). Width is capped at the card edge; the very wide
     lockups clamp there rather than overflow. */
  .vb-card img {
    width: 84%; height: calc(20% * var(--s, 1)); object-fit: contain;
  }

  /* panel deck · slide 2: BU bars grow, then merge into one */
  .comp-vepchart { position: relative; }
  .vepchart-svg svg { width: 100%; height: auto; display: block; }
  .bc-bars {
    position: absolute; left: 35.5%; width: 56.44%;
    bottom: 18.51%; height: 73.43%;
    display: flex; align-items: flex-end; gap: 1.4%;
    transition: gap 0.6s var(--ease), opacity 0.5s var(--ease);
  }
  .bc-bar {
    flex: 1; height: 0; border-radius: 10px 10px 0 0;
    background: linear-gradient(180deg, #2f6fe4 0%, #1b4fc4 100%);
    transition: height 0.6s var(--ease), border-radius 0.5s var(--ease);
  }
  .bc-bar.is-grown { height: var(--h); }
  .comp-vepchart.is-merged .bc-bars { gap: 0; }
  .comp-vepchart.is-merged .bc-bar { height: 100%; border-radius: 0; }
  .comp-vepchart.is-merged .bc-bar:first-child { border-top-left-radius: 8%; }
  .comp-vepchart.is-merged .bc-bar:last-child { border-top-right-radius: 8%; }
  .comp-vepchart.is-swapped .bc-bars { opacity: 0; }

  /* panel deck · slide 4: the ecosystem, its own gray panel baked in */
  .comp-ecosystem { position: relative; }
  .ecosystem-svg svg { width: 100%; height: auto; display: block; }

  /* panel deck · slide 3: one pattern, two products */
  .comp-platformmindset { position: relative; aspect-ratio: 5 / 4; }
  .comp-platformmindset img { display: block; width: 100%; height: auto; }
  .pm-chat { position: absolute; filter: drop-shadow(0 18px 40px rgba(17, 21, 28, 0.16)); }
  .pm-tt { left: 8%; top: 24%; width: 38%; z-index: 1; }
  .pm-ck { left: 52%; top: 12%; width: 38%; z-index: 2; }
  .pm-badge { position: absolute; z-index: 4; }
  .pm-tt-icon { left: 2%; top: 17%; width: 17%; }
  .pm-ck-icon { left: 46%; top: 5%; width: 17%; }
  .pm-arrow { position: absolute; z-index: 5; }
  .pm-arr-top { left: 30%; top: 2%; width: 15%; }
  .pm-arr-bot { left: 58%; bottom: 2%; width: 15%; }

  /* ai-native · slide 2: two archetype circles with tag pills */
  /* max-width scales the whole thing down uniformly, so the circle-to-tag
     ratio stays exactly as measured from the example */
  .comp-archetypes2 {
    padding: clamp(var(--s-5), 4vh, var(--s-10)) 0;
    max-width: 84%; margin-inline: auto;
  }
  /* proportions traced from 02_archetype_example.png: the circles sit edge to
     edge (their transparent padding keeps them visually apart) and each tag
     pill is ~53% of the photo's width, overlapping its lower edge. */
  .arch-row { display: flex; justify-content: center; gap: 0; }
  .arch-card { position: relative; width: 50%; max-width: none; flex: none; margin: 0; transition: transform 0.9s var(--ease) 0.9s; }
  .arch-card:nth-child(1) { z-index: 2; }
  /* the photos carry ~11% transparent padding on every side; zooming past it
     is what makes the people bigger without the circles colliding */
  .arch-zoom { display: block; transform: scale(1.25); }
  /* NOTE: this must out-specify `.comp img { width: 100% }` above, or the
     pill silently renders full-card-width no matter what is set here.
     Ratio traced from the example: the pill is 202px under a 299px circle,
     i.e. 67.6% of the circle, sitting 96.7% of the way down it. */
  .comp-archetypes2 .arch-tag {
    position: absolute; left: 50%; bottom: -4%; transform: translateX(-50%);
    width: 66%; height: auto; z-index: 3;
    filter: drop-shadow(0 8px 18px rgba(17, 21, 28, 0.18));
  }

  /* concierge · slide 6: two archetype circles. These photos are already
     tight circular crops, so no zoom, and a slightly smaller tag ratio. */
  .comp-duo { padding: clamp(var(--s-5), 4vh, var(--s-10)) 0; max-width: 90%; margin-inline: auto; }
  .comp-duo .arch-row { gap: clamp(var(--s-4), 3vw, var(--s-8)); }
  .comp-duo .arch-zoom { transform: none; }
  .comp-duo .arch-tag {
    position: absolute; left: 50%; bottom: -4%; transform: translateX(-50%);
    width: 62%; height: auto; z-index: 3;
    filter: drop-shadow(0 8px 18px rgba(17, 21, 28, 0.18));
  }

  /* concierge · slide 2: activate-experts collage (positions from example) */
  .comp-activate { position: relative; aspect-ratio: 1045 / 824; }
  .comp-activate img { display: block; width: 100%; height: auto; }
  /* positions measured pixel-for-pixel from 02_activate-experts_example-layout.png */
  .ac-blob { position: absolute; left: 15.4%; top: 12.4%; width: 57.2%; margin: 0; z-index: 1; }
  .ac-card { left: 61.4%; top: 17.9%; width: 32%; z-index: 4; }
  .ac-tax { left: 16.1%; top: 7.9%; width: 10.3%; z-index: 3; }
  .ac-check { left: 14.5%; top: 28.8%; width: 10%; z-index: 3; }
  .ac-iep { left: 49.5%; top: 73.8%; width: 14.3%; z-index: 5; }
  .ac-cal { left: 66.9%; top: 72%; width: 9.6%; z-index: 3; }
  .ac-notif { left: 6.6%; top: 68.4%; width: 33.3%; z-index: 4; }

  /* concierge · slide 4: the wide E2E flow, fit to the figure width */
  .comp-flow { width: 100%; }
  .flow-svg svg { width: 100%; height: auto; display: block; }

  /* concierge · slide 4 (flowdeck): the diagram's real nodes start piled in a
     stack, fan out to their true positions in reading order, then the detailed
     SVG resolves in on top and the placeholders retire. */
  .comp-flowdeck { position: relative; aspect-ratio: 6288 / 2327; }
  /* the diagram's own outer frame — light-blue fill + blue stroke — drawn from
     the start so the stack and fan-out happen inside it; the resolved SVG
     overlays an identical frame, so the swap is seamless. geometry matches the
     container path in 04_e2e-concierge-flow.svg (0.6%-99.4% x, 1.7%-98.3% y). */
  .comp-flowdeck .fd-frame {
    position: absolute;
    left: 0.6%; top: 1.7%; width: 98.8%; height: 96.6%;
    box-sizing: border-box;
    background: #f4f9ff;
    border: 2.5px solid #3492ef;
    border-radius: clamp(8px, 0.8vw, 14px);
  }
  .comp-flowdeck .fd-final {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: contain; opacity: 0; pointer-events: none;
    transition: opacity 0.7s var(--ease);
  }
  .comp-flowdeck .fd-nodes { position: absolute; inset: 0; }
  .fd-node {
    position: absolute;
    box-sizing: border-box;
    /* stacked start: real position offset back to the shared anchor */
    left: calc((var(--l) + var(--dx)) * 1%);
    top: calc((var(--t) + var(--dy)) * 1%);
    width: calc(var(--w) * 1%);
    height: calc(var(--h) * 1%);
    background: #fff;
    border: 1.5px solid #a9bce4;
    border-radius: 4px;
    box-shadow: 0 6px 14px -8px rgba(17, 21, 28, 0.35);
    /* stacked look: each card offset into a neat diagonal pile + slight jitter */
    transform: translate(calc(var(--i) * 1.4px), calc(var(--i) * -0.9px))
      scale(0.82) rotate(var(--r));
    transition: left 0.8s var(--ease), top 0.8s var(--ease),
      transform 0.8s var(--ease);
  }
  .fd-r { border-radius: 50%; background: #d3e2fb; border-color: #7ba7e8; }
  .fd-d {
    background: #adffe8; border: none; box-shadow: none;
    clip-path: polygon(50% 1%, 99% 50%, 50% 99%, 1% 50%);
  }
  /* keep the whole comp visible; the pieces stage in via .is-in on the root */
  html.js .comp-flowdeck[data-reveal] { opacity: 1; transform: none; transition: none; }
  /* fan out: each node flies home, staggered left-to-right, top-to-bottom */
  .comp-flowdeck.is-in .fd-node {
    left: calc(var(--l) * 1%);
    top: calc(var(--t) * 1%);
    transform: translate(0, 0) scale(1) rotate(0deg);
    transition-delay: calc(var(--i) * 45ms);
  }
  /* once fanned out, resolve to the detailed diagram and retire placeholders */
  .comp-flowdeck.is-in .fd-final { opacity: 1; transition-delay: 2.4s; }
  .comp-flowdeck.is-in .fd-nodes { opacity: 0; transition: opacity 0.6s var(--ease) 2.6s; }

  @media (prefers-reduced-motion: reduce) {
    .comp-flowdeck .fd-final { opacity: 1 !important; transition: none; }
    .comp-flowdeck .fd-nodes { display: none; }
  }

  /* hia · "Design is never done": a seamless infinity loop, a colored segment
     traveling endlessly around the ∞ (stroke-dasharray + dashoffset). Recoloured
     to the brand blue; the dash lengths are measured by the script. */
  .comp-infinity { display: grid; place-items: center; padding: clamp(var(--s-6), 6vh, var(--s-12)) 0; }
  .comp-infinity .nd-loop { width: min(66vh, 34rem); height: auto; overflow: visible; }
  .comp-infinity .nd-loop path { stroke-width: 13; stroke-linecap: round; }
  .comp-infinity .nd-track { stroke: color-mix(in srgb, var(--accent) 18%, transparent); }
  .comp-infinity .nd-master {
    stroke: var(--accent);
    stroke-dasharray: var(--nd-dash, 0), var(--nd-gap, 9999);
    animation: nd-loop 2.3s linear infinite;
  }
  @keyframes nd-loop {
    from { stroke-dashoffset: var(--nd-len, 0); }
    to   { stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .comp-infinity .nd-master { animation: none; stroke-dasharray: none; }
  }

  /* concierge · slide 10 "zero to one": drifting dots in shades of the brand
     blue; a subset flies in to form 0, holds, scatters, and re-forms as 1 —
     modeled on Allan Pope's "Dots Countdown". No background; sized by the script. */
  .comp-dotloop { position: relative; width: 100%; aspect-ratio: 3 / 2; }
  .comp-dotloop .dl-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* kit · "Designing the journey": the customer-journey example rebuilt from its
     pieces. z-order: background colour, shapes, text, then the cursors. Positions
     are % of the composition and easy to nudge. */
  .comp-journey {
    position: relative; aspect-ratio: 2475 / 1593; overflow: clip;
    border-radius: var(--radius); container-type: inline-size;
  }
  .comp-journey .jr-bg { position: absolute; inset: 0; background: #e8ecfc; z-index: 0; }
  .comp-journey .jr-shapes {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: contain; z-index: 1;
  }
  .comp-journey .jr-text {
    position: absolute; z-index: 2; left: 50%; top: 49%; transform: translate(-50%, -50%);
    margin: 0; text-align: center; color: #5b3fd6; white-space: nowrap;
    font-family: var(--font-sans); font-weight: 800; line-height: 1.06;
    letter-spacing: -0.01em; font-size: clamp(1.1rem, 7.2cqw, 3.4rem);
  }
  .comp-journey .jr-cur { position: absolute; z-index: 3; height: auto; will-change: transform; }
  /* base positions */
  .comp-journey .jr-customer { left: 3%;  top: 4%;  width: 19%; }
  .comp-journey .jr-cx       { left: 46%; top: 29%; width: 10%; }
  .comp-journey .jr-designer { left: 43%; top: 52%; width: 18%; }
  /* each cursor traces the SAME triangle around its spot: a fluid glide to a
     vertex, a short pause, then on to the next. Staggered by a third of the loop
     with longer glides, so two can be in motion at once (one arriving as the
     next sets off). Distances in cqw, so the path scales. */
  .comp-journey .jr-cur { animation: jr-triangle 12s cubic-bezier(0.5, 0, 0.25, 1) infinite; }
  .comp-journey .jr-customer { animation-delay: 0s; }
  .comp-journey .jr-cx       { animation-delay: -4s; }
  .comp-journey .jr-designer { animation-delay: -8s; }
  @keyframes jr-triangle {
    0%,  10%  { transform: translate(0, 0); }              /* settle at the base vertex */
    28%, 40%  { transform: translate(5cqw, 4.5cqw); }      /* glide to vertex 2, pause */
    58%, 70%  { transform: translate(-5cqw, 4.5cqw); }     /* glide to vertex 3, pause */
    88%, 100% { transform: translate(0, 0); }              /* glide back, pause */
  }
  @media (prefers-reduced-motion: reduce) {
    .comp-journey .jr-cur { animation: none; }
  }

  /* concierge · slide 4 (animated): cards start stacked, fan into an organized
     row, then a journey line draws left to right connecting them */
  .comp-cardflow { position: relative; aspect-ratio: 16 / 7; }
  .cf-card {
    position: absolute; top: 18%; width: 15%; aspect-ratio: 3 / 4;
    background: #fff; border: 1px solid var(--line); border-radius: 12px;
    box-shadow: 0 14px 30px -18px rgba(17, 21, 28, 0.4);
    padding: 8%; display: flex; flex-direction: column; gap: 8%;
    transition: transform 0.75s var(--ease); z-index: 1;
  }
  .cf-card-0 { left: 3%; }
  .cf-card-1 { left: 23.5%; }
  .cf-card-2 { left: 44%; }
  .cf-card-3 { left: 64.5%; }
  .cf-card-4 { left: 85%; }
  .cf-bar { display: block; height: 12%; border-radius: 4px; background: var(--accent); width: 62%; }
  .cf-rows { display: block; flex: 1; border-radius: 6px;
    background: repeating-linear-gradient(var(--line-soft) 0 18%, transparent 18% 34%); }
  .cf-node {
    position: absolute; left: 50%; bottom: -13%; transform: translateX(-50%);
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--accent); border: 3px solid var(--paper); z-index: 3;
  }
  /* the connecting journey line, behind the cards, drawn after they settle */
  .cf-line {
    position: absolute; left: 3%; right: 3%; top: calc(18% + 66%);
    height: 3px; background: var(--accent); border-radius: 2px;
    transform: scaleX(0); transform-origin: left center; z-index: 0;
  }

  /* concierge · slide 5: a genuine outline morph, Salesforce -> IEP.
     The visible path's `d` is tweened point-by-point by the script below. */
  .comp-crm { display: grid; place-items: center; padding: clamp(var(--s-6), 6vh, var(--s-12)) 0; }
  .crm-morph { width: min(38vh, 18rem); height: auto; overflow: visible; }
  .crm-src { position: absolute; width: 0; height: 0; overflow: hidden; opacity: 0; pointer-events: none; }

  /* concierge · slide 10: an odometer that slides 0 up to 1 (and loops) */
  .comp-zto { display: grid; place-items: center; padding: clamp(var(--s-6), 6vh, var(--s-12)) 0; }
  /* one blue glyph at a time; 0 and 1 stacked, swapping with a right-to-left
     glitchy twitch (only the motion is borrowed from the reference gif) */
  .zto-num { position: relative; display: grid; place-items: center; }
  .zto-d {
    grid-area: 1 / 1;
    font-family: var(--font-display); font-weight: 700;
    font-size: min(30vh, 16rem); line-height: 1; color: var(--accent);
    opacity: 0; will-change: transform, opacity;
  }
  .comp-zto.is-in .zto-d0 { animation: zto-zero 4s steps(1, end) infinite; }
  .comp-zto.is-in .zto-d1 { animation: zto-one 4s steps(1, end) infinite; }
  /* steps() keeps each frame crisp so the shifts read as glitchy twitches */
  @keyframes zto-zero {
    0%, 40%          { opacity: 1; transform: translateX(0); }
    42%              { opacity: 1; transform: translateX(0.05em); }
    44%              { opacity: 1; transform: translateX(-0.09em); }
    46%              { opacity: 1; transform: translateX(0.04em); }
    48%              { opacity: 1; transform: translateX(-0.03em); }
    50%, 90%         { opacity: 0; transform: translateX(-0.6em); }
    92%              { opacity: 0; transform: translateX(0.55em); }
    94%              { opacity: 1; transform: translateX(0.08em); }
    96%              { opacity: 1; transform: translateX(-0.05em); }
    98%              { opacity: 1; transform: translateX(0.03em); }
    100%             { opacity: 1; transform: translateX(0); }
  }
  @keyframes zto-one {
    0%, 40%          { opacity: 0; transform: translateX(0.55em); }
    42%              { opacity: 0; transform: translateX(0.55em); }
    44%              { opacity: 1; transform: translateX(0.08em); }
    46%              { opacity: 1; transform: translateX(-0.05em); }
    48%              { opacity: 1; transform: translateX(0.03em); }
    50%, 90%         { opacity: 1; transform: translateX(0); }
    92%              { opacity: 1; transform: translateX(0.05em); }
    94%              { opacity: 1; transform: translateX(-0.09em); }
    96%              { opacity: 1; transform: translateX(0.04em); }
    98%              { opacity: 0; transform: translateX(-0.6em); }
    100%             { opacity: 0; transform: translateX(-0.6em); }
  }
  @media (prefers-reduced-motion: reduce) {
    .comp-zto .zto-d0 { opacity: 0; animation: none; }
    .comp-zto .zto-d1 { opacity: 1; animation: none; transform: none; }
  }

  /* about-jd · slide 1: "execution" struck out, "strategic leadership" replaces it */
  .comp-jdstrike {
    display: grid; place-items: center; text-align: center;
    gap: clamp(var(--s-3), 2vh, var(--s-5)); padding: clamp(var(--s-4), 4vh, var(--s-8)) 0;
  }
  .jds-old { position: relative; display: inline-block; }
  .jds-word {
    font-family: var(--font-sans); font-weight: 300;
    font-size: clamp(2rem, 1rem + 4vw, 4rem); line-height: 1;
    color: color-mix(in srgb, var(--ink) 42%, transparent); letter-spacing: 0.01em;
  }
  .jds-line {
