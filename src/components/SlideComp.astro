  <div class="comp comp-hiaprocess" data-reveal aria-label="The design process loops continuously">
    <svg class="hp-svg" viewBox="0 0 200 200" role="img" aria-label="A looping design process">
      <defs>
        <marker id="hp-arrow" markerWidth="6" markerHeight="6" refX="2.6" refY="3" orient="auto">
          <path d="M0 0 L6 3 L0 6 Z" fill="var(--accent)" />
        </marker>
      </defs>
      <circle class="hp-track" cx="100" cy="100" r="68" />
      <g class="hp-ring">
        <path d="M36 77 A68 68 0 0 1 164 77" marker-end="url(#hp-arrow)" />
        <path d="M164 123 A68 68 0 0 1 36 123" marker-end="url(#hp-arrow)" />
      </g>
      <g class="hp-nodes">
        <circle cx="100" cy="32" r="5" />
        <circle cx="168" cy="100" r="5" />
        <circle cx="100" cy="168" r="5" />
        <circle cx="32" cy="100" r="5" />
      </g>
