)}

{/* hia · slide 4: a question and an alert both route to support, which searches
    content resources in turn, then replies */}
{name === "deescalation" && (
  <div class="comp comp-deesc" data-reveal role="img" aria-label="A question and an alert both route to support, which searches internal articles, external articles, community, and memos in turn before replying with an answer.">
    <div class="de-stage">
      <svg class="de-wires" viewBox="0 0 1045 824" aria-hidden="true">
        <path class="de-wire de-wire-q" d="M300 196 H522" />
        <path class="de-wire de-wire-a" d="M744 196 H522" />
        <path class="de-wire de-wire-down" d="M522 196 V404" />
        <path class="de-arrow" d="M506 388 L522 407 L538 388" />
      </svg>
      <img class="de-icon de-question" src={`${hiaBase}/04_de-escalation_question.svg`} alt="" />
      <img class="de-icon de-ask" src={`${hiaBase}/04_de-escalation_ask.svg`} alt="" />
      <img class="de-icon de-support" src={`${hiaBase}/04_de-escalation_support.svg`} alt="" />
      <div class="de-process" aria-hidden="true">
        <img class="de-step de-step-1" src={`${hiaBase}/04_de-escalation_process-01-internal-articles.svg`} alt="" />
        <span class="de-seg de-seg-1"></span>
        <img class="de-step de-step-2" src={`${hiaBase}/04_de-escalation_process-02-external-articles.svg`} alt="" />
        <span class="de-seg de-seg-2"></span>
        <img class="de-step de-step-3" src={`${hiaBase}/04_de-escalation_process-03-community.svg`} alt="" />
        <span class="de-seg de-seg-3"></span>
        <img class="de-step de-step-4" src={`${hiaBase}/04_de-escalation_process-04-memos.svg`} alt="" />
        <span class="de-seg de-seg-4"></span>
        <img class="de-step de-step-5" src={`${hiaBase}/04_de-escalation_process-05-reply.svg`} alt="" />
      </div>
    </div>
  </div>
)}

<script>
  import { separate } from "flubber";

  // research 2x2: click a tile to zoom it over the grid, click again (or
  // another tile, or Escape) to restore
  document.querySelectorAll<HTMLElement>(".comp-research .research-tile").forEach((tile) => {
    tile.addEventListener("click", () => {
      const wasZoomed = tile.classList.contains("is-zoom");
      tile.closest(".comp-research")
        ?.querySelectorAll(".is-zoom")
        .forEach((z) => z.classList.remove("is-zoom"));
      if (!wasZoomed) tile.classList.add("is-zoom");
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    document.querySelectorAll(".comp-research .is-zoom").forEach((z) => z.classList.remove("is-zoom"));
  });

  // Heavy media (the interview gif) carries no src until the slide is close,
  // so the page never pays for it unless the viewer actually gets there.
  document.querySelectorAll<HTMLElement>("[data-lazy-src]").forEach((el) => {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.disconnect();
          const src = el.dataset.lazySrc;
          if (!src) return;
          (el as HTMLImageElement | HTMLVideoElement).src = src;
          if (el instanceof HTMLVideoElement) {
            el.load();
            el.play().catch(() => {
              /* autoplay blocked; the poster frame still shows */
            });
          }
        }
      },
      { rootMargin: "400px 0px" },
    );
    io.observe(el);
  });

  // VEP chart: once the slide arrives, each BU bar grows left to right at its
  // own height, then they all merge into the single platform-wide bar.
  const reduceChart = window.matchMedia("(prefers-reduced-motion: reduce)");
  document.querySelectorAll<HTMLElement>(".comp-vepchart").forEach((comp) => {
    const bars = Array.from(comp.querySelectorAll<HTMLElement>(".bc-bar"));
    if (!bars.length) return;
    if (reduceChart.matches) {
      comp.classList.add("is-merged", "is-swapped");
      bars.forEach((b) => b.classList.add("is-grown"));
      return;
    }
    let played = false;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting || played) continue;
          played = true;
          io.unobserve(e.target);
          const step = 320;
          bars.forEach((b, i) => window.setTimeout(() => b.classList.add("is-grown"), 500 + i * step));
          const settled = 500 + bars.length * step + 400;
          window.setTimeout(() => comp.classList.add("is-merged"), settled);
          window.setTimeout(() => comp.classList.add("is-swapped"), settled + 700);
        }
      },
      { threshold: 0.4 },
    );
    io.observe(comp);
  });

  // impact deck: shuffle the top card to the back every couple of seconds.
  // Runs only while on screen, pauses on hover, and sits still under
  // reduced motion (top card stays visible).
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  document.querySelectorAll<HTMLElement>("[data-deck]").forEach((stack) => {
    const order = Array.from(stack.children) as HTMLElement[];
    const relayer = () =>
      order.forEach((c, i) => {
        c.style.zIndex = String(order.length - i);
        c.style.setProperty("--depth", String(Math.min(i, 4)));
        c.classList.toggle("is-front", i === 0);
      });
    relayer();
    if (order.length < 2 || reduceMotion.matches) return;
    let paused = false;
    let visible = false;
    stack.addEventListener("mouseenter", () => (paused = true));
    stack.addEventListener("mouseleave", () => (paused = false));
    new IntersectionObserver(
      (es) => es.forEach((e) => (visible = e.isIntersecting)),
      { threshold: 0.3 },
    ).observe(stack);
    setInterval(() => {
      if (paused || !visible || document.hidden) return;
      const top = order.shift()!;
      order.push(top);
      top.classList.add("is-out");
      window.setTimeout(relayer, 320);
      window.setTimeout(() => top.classList.remove("is-out"), 660);
    }, 2400);
  });
  // clicking anywhere off the tiles also restores the 2x2
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest(".research-tile")) return;
    document.querySelectorAll(".comp-research .is-zoom").forEach((z) => z.classList.remove("is-zoom"));
  });

  // crm slide: a genuine cloud -> IEP morph. The IEP mark is three arrows (six
  // subpaths), so a single closed loop can't draw it — that was the broken
  // frame. flubber.separate() splits the cloud into those pieces and morphs each
  // one correctly. Both logos are normalised into the same 240 box (matching the
  // crisp logos' fit transform) so t=0 lands on the cloud and t=1 on the IEP.
  const crmReduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  document.querySelectorAll<SVGSVGElement>("[data-crm-morph]").forEach((svg) => {
    const comp = svg.closest(".comp-crm")!;
    const sfEl = comp.querySelector<SVGPathElement>(".crm-src-sf");
    const iepEl = comp.querySelector<SVGPathElement>(".crm-src-iep");
    const src = comp.querySelector<SVGSVGElement>(".crm-src");
    const out = svg.querySelector<SVGPathElement>(".crm-morph-path");
    const finalEl = svg.querySelector<SVGPathElement>(".crm-iep-final");
    const realSf = svg.querySelector<SVGPathElement>(".crm-real-sf");
    if (!sfEl || !iepEl || !src || !out || !finalEl || !realSf) return;

    const sample = (path: SVGPathElement, count: number) => {
      const len = path.getTotalLength();
      const pts: [number, number][] = [];
      for (let i = 0; i < count; i++) {
        const p = path.getPointAtLength((len * i) / count);
        pts.push([p.x, p.y]);
      }
      return pts;
    };
    // map points into the shared 240 box, matching the fit() transform below so
    // the morph endpoints line up with the crisp logos
    const norm = (pts: [number, number][], bb: DOMRect) => {
      const s = 170 / Math.max(bb.width, bb.height);
      const cx = bb.x + bb.width / 2, cy = bb.y + bb.height / 2;
      return pts.map(([x, y]) => [120 + s * (x - cx), 120 + s * (y - cy)] as [number, number]);
    };
    const fit = (el: SVGPathElement) => {
      const bb = el.getBBox();
      const s = 170 / Math.max(bb.width, bb.height);
      return `translate(120 120) scale(${s}) translate(${-(bb.x + bb.width / 2)} ${-(bb.y + bb.height / 2)})`;
    };
    finalEl.setAttribute("transform", fit(iepEl));
    realSf.setAttribute("transform", fit(sfEl));

    // the cloud is one ring; the IEP mark is its six subpaths, each sampled in
    // the SHARED iep box so they keep their arrangement
    const iepBB = iepEl.getBBox();
    const subs = (iepEl.getAttribute("d") || "").match(/[Mm][^Mm]*/g) || [];
    const tmp = document.createElementNS("http://www.w3.org/2000/svg", "path");
    src.appendChild(tmp);
    const iepRings = subs.map((d) => {
      tmp.setAttribute("d", d);
      return norm(sample(tmp, 64), iepBB);
    });
    tmp.remove();
    const cloudRing = norm(sample(sfEl, 200), sfEl.getBBox());

    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    let interp: ((t: number) => string) | null = null;
    try {
      // t = 0 -> cloud, t = 1 -> IEP (cloud split across the six pieces)
      interp = separate(cloudRing, iepRings, { single: true, maxSegmentLength: 6 }) as (t: number) => string;
    } catch { interp = null; }

    // Show ONLY the morph path — no opacity crossfades anywhere, so there is
    // nothing to fade in/out and nothing to flash. Flubber's endpoints already
    // ARE the shapes: t=0 is the Salesforce cloud, t=1 is the IEP mark. The crisp
    // SVG logos are only used as a no-JS / reduced-motion fallback.
    finalEl.style.opacity = "0"; realSf.style.opacity = "0";
    if (!interp) { finalEl.style.opacity = "1"; return; } // fallback: crisp IEP, no morph
    const morph = interp;
    out.setAttribute("d", morph(0));
    out.style.opacity = "1";
    if (crmReduce.matches) { out.setAttribute("d", morph(1)); return; } // static, no loop

    const DELAY = 700, MORPH = 1050, HOLD = 850;
    let running = false;
    const run = (a: number, b: number, done: () => void) => {
      const t0 = performance.now();
      const frame = (now: number) => {
        const m = Math.min((now - t0) / MORPH, 1);
        out.setAttribute("d", morph(a + (b - a) * ease(m)));
        if (m < 1) requestAnimationFrame(frame);
        else window.setTimeout(done, HOLD);
      };
      requestAnimationFrame(frame);
    };
    const toIep = () => run(0, 1, toSf);
    const toSf = () => run(1, 0, toIep);

    new IntersectionObserver((es, obs) => {
      for (const e of es) {
        if (e.isIntersecting && !running) {
          running = true;
          obs.disconnect();
          window.setTimeout(toIep, DELAY);
        }
      }
    }, { threshold: 0.4 }).observe(comp);
  });

  // "Design is never done": measure the ∞ path so the moving segment (60% of the
  // loop) and its dashoffset animation are exact and seamless.
  document.querySelectorAll<SVGSVGElement>("[data-nd-loop]").forEach((svg) => {
    const master = svg.querySelector<SVGPathElement>(".nd-master");
    if (!master) return;
    const len = master.getTotalLength();
    const dash = len * 0.6;
    master.style.setProperty("--nd-len", String(len));
    master.style.setProperty("--nd-dash", String(dash));
    master.style.setProperty("--nd-gap", String(len - dash));
  });

  // "zero to one": modeled on Allan Pope's "Dots Countdown". A field of faint
  // multicolour dots drifts at random; a subset flies in (with per-dot random
  // timing) to form 0, holds, scatters back to the drift, and re-forms as 1.
  document.querySelectorAll<HTMLCanvasElement>("[data-dotloop]").forEach((canvas) => {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const CHARS = ["0", "1"];
    // shades around the brand blue (#1e54e8 / accent-navy / accent-ink)
    const COLORS = ["30,84,232", "91,140,255", "60,110,245", "22,63,176"];
    const R = 2.4, GAP = 7;              // dot radius + sampling grid (dot spacing)
    const FORM_HOLD = 4200, SCATTER_GAP = 1600; // hold formed, then drift, before the next
    const rand = (a: number, b: number) => Math.random() * (b - a) + a;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    let W = 0, H = 0, dpr = 1;
    const oc = document.createElement("canvas");
    const octx = oc.getContext("2d")!;
    // sample a glyph on a regular grid -> [x,y] dot targets, centered
    const coordsFor = (ch: string): number[][] => {
      octx.clearRect(0, 0, W, H);
      octx.fillStyle = "#fff"; octx.textAlign = "center"; octx.textBaseline = "middle";
      octx.font = `900 ${Math.round(H * 0.9)}px "Hanken Grotesk", "Lato", system-ui, sans-serif`;
      octx.fillText(ch, W / 2, H / 2 + H * 0.03);
      const d = octx.getImageData(0, 0, W, H).data;
      const pts: number[][] = [];
      for (let y = 0; y < H; y += GAP)
        for (let x = 0; x < W; x += GAP)
          if (d[(y * W + x) * 4 + 3] > 128) pts.push([x, y]);
      return pts;
    };

    type D = {
      x: number; y: number; alpha: number; color: string; drift: boolean;
      sx: number; sy: number; sa: number; tx: number; ty: number; ta: number; t0: number; dur: number;
    };
    let dots: D[] = [];
    let coords: number[][][] = [];
    const tween = (d: D, tx: number, ty: number, ta: number, dur: number, now: number) => {
      d.sx = d.x; d.sy = d.y; d.sa = d.alpha; d.tx = tx; d.ty = ty; d.ta = ta; d.t0 = now; d.dur = dur;
    };
    const drift = (d: D, now: number) => { tween(d, rand(0, W), rand(0, H), 0.28, rand(2600, 4200), now); d.drift = true; };

    const build = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = Math.round(rect.width); H = Math.round(rect.height);
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      oc.width = W; oc.height = H;
      coords = CHARS.map(coordsFor);
      const maxN = Math.max(1, ...coords.map((c) => c.length));
      const total = maxN + Math.round(maxN * 0.55); // number dots + ambient drifters
      if (dots.length !== total) {
        const now = performance.now();
        dots = Array.from({ length: total }, () => {
          const x = rand(0, W), y = rand(0, H);
          const d: D = { x, y, alpha: 0.28, color: COLORS[Math.floor(rand(0, COLORS.length))], drift: true, sx: x, sy: y, sa: 0.28, tx: x, ty: y, ta: 0.28, t0: now, dur: 1 };
          drift(d, now); return d;
        });
      }
    };
    build();

    if (reduce) { // static: just show the formed "1"
      const c = coords[1] || [];
      ctx.clearRect(0, 0, W, H);
      for (let i = 0; i < dots.length; i++) {
        const p = c[i]; if (!p) continue;
        ctx.beginPath(); ctx.arc(p[0], p[1], R, 0, 6.2832); ctx.fillStyle = `rgba(${dots[i].color},1)`; ctx.fill();
      }
      return;
    }

    let idx = 0, timer = 0, running = false;
    const form = (now: number) => {
      const c = coords[idx];
      for (let i = 0; i < dots.length; i++) {
        if (i < c.length) { tween(dots[i], c[i][0], c[i][1], 1, rand(1300, 2300), now); dots[i].drift = false; }
        else if (!dots[i].drift) drift(dots[i], now);
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => scatter(performance.now()), FORM_HOLD);
    };
    const scatter = (now: number) => {
      for (const d of dots) drift(d, now);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { idx = (idx + 1) % CHARS.length; form(performance.now()); }, SCATTER_GAP);
    };

    const loop = (now: number) => {
      ctx.clearRect(0, 0, W, H);
      for (const d of dots) {
        const k = ease(Math.min((now - d.t0) / d.dur, 1));
        d.x = d.sx + (d.tx - d.sx) * k;
        d.y = d.sy + (d.ty - d.sy) * k;
        d.alpha = d.sa + (d.ta - d.sa) * k;
        if (k >= 1 && d.drift) drift(d, now); // ambient dots keep wandering
        ctx.beginPath(); ctx.arc(d.x, d.y, R, 0, 6.2832);
        ctx.fillStyle = `rgba(${d.color},${d.alpha.toFixed(3)})`; ctx.fill();
      }
      requestAnimationFrame(loop);
    };

    new IntersectionObserver((es, obs) => {
      for (const e of es)
        if (e.isIntersecting && !running) {
          running = true; obs.disconnect();
          requestAnimationFrame(loop);
          form(performance.now());
        }
    }, { threshold: 0.3 }).observe(canvas);
    window.addEventListener("resize", build);
  });

  // "De-escalation by design": the story timeline. Question + alert route to
  // support; support loads each content resource (drawing a connector into it),
  // scans back and forth through them a few times ("processing"), then replies.
  document.querySelectorAll<HTMLElement>(".comp-deesc").forEach((comp) => {
    const q = comp.querySelector<HTMLElement>(".de-question");
    const a = comp.querySelector<HTMLElement>(".de-ask");
    const support = comp.querySelector<HTMLElement>(".de-support");
    const wires = Array.from(comp.querySelectorAll<SVGElement>(".de-wire, .de-arrow"));
    const steps = Array.from(comp.querySelectorAll<HTMLElement>(".de-step"));
    const segs = Array.from(comp.querySelectorAll<HTMLElement>(".de-seg"));
    if (!q || !a || !support || steps.length < 5) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      [q, a, support].forEach((e) => e.classList.add("on"));
      wires.forEach((w) => w.classList.add("on"));
      steps.forEach((s) => s.classList.add("loaded"));
      segs.forEach((s) => s.classList.add("drawn"));
      return;
    }

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const reset = () => {
      [q, a, support].forEach((e) => e.classList.remove("on", "working"));
      wires.forEach((w) => w.classList.remove("on"));
      steps.forEach((s) => s.classList.remove("loaded", "scan"));
      segs.forEach((s) => s.classList.remove("drawn"));
    };

    let running = false;
    const play = async () => {
      // eslint-disable-next-line no-constant-condition
      while (true) {
        reset();
        await wait(500);
        q.classList.add("on"); await wait(350);
        a.classList.add("on"); await wait(600);
        wires.forEach((w) => w.classList.add("on")); await wait(850);
        support.classList.add("on"); await wait(650);
        // load all five, drawing the connector into each
        for (let i = 0; i < steps.length; i++) {
          if (i > 0) segs[i - 1].classList.add("drawn");
          steps[i].classList.add("loaded");
          await wait(480);
        }
        await wait(350);
        // process: sweep through all five, each growing a bit, a few times
        for (let pass = 0; pass < 3; pass++) {
          for (let i = 0; i < steps.length; i++) {
            steps[i].classList.add("scan");
            await wait(130);
            steps[i].classList.remove("scan");
          }
        }
        await wait(2600);
      }
    };

    new IntersectionObserver((es, obs) => {
      for (const e of es)
        if (e.isIntersecting && !running) { running = true; obs.disconnect(); play(); }
    }, { threshold: 0.3 }).observe(comp);
  });
</script>

<style is:global>
  /* inlined grandpa svg: size like the img it replaced, and blink. The blink
     squishes the .gp-eyes group (whites + pupils) shut toward its center. */
  .gp-svg svg { width: 100%; height: auto; display: block; }
  .gp-eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: gp-blink 4.2s ease-in-out infinite;
  }
  @keyframes gp-blink {
    0%, 93%, 100% { transform: scaleY(1); }
    95.5% { transform: scaleY(0.08); }
    98% { transform: scaleY(1); }
  }
  /* pupils stay locked on the cloud (up and to his left) with a slow
     micro-drift, like he is tracking it as it hovers */
  .gp-pupils {
    animation: gp-gaze 7s ease-in-out infinite;
  }
  @keyframes gp-gaze {
    0%, 100% { transform: translate(-1.5px, -1px); }
    28% { transform: translate(-2.5px, -2px); }
    52% { transform: translate(-1px, -0.5px); }
    76% { transform: translate(-2px, -1.5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gp-eyes, .gp-pupils { animation: none; }
  }

  /* inlined capability map: redlines are spec annotations, drawn like a spec
     pass. Per group (staggered via --rd, set in the file): the bracket fades
     in at the measured element, the line grows out of the bracket toward the
     number, and the numbered marker pops when the line arrives. */
  .capmap-svg svg, .redlining-svg svg { width: 100%; height: auto; display: block; }
  .capmap-svg .rl-line { transform-box: fill-box; }
  .capmap-svg .rl-from-right { transform-origin: right center; }
  .capmap-svg .rl-from-left { transform-origin: left center; }
  .capmap-svg .rl-circle, .capmap-svg .rl-num { transform-box: fill-box; transform-origin: center; }
  html.js .comp-capmap:not(.is-in) [id^="redline_"] { opacity: 0; }
  .comp-capmap.is-in [id^="redline_"] { opacity: 1; }
  .comp-capmap.is-in .rl-bracket { animation: rl-fade 0.3s var(--ease) var(--rd, 0s) backwards; }
  .comp-capmap.is-in .rl-line { animation: rl-grow 0.5s var(--ease) calc(var(--rd, 0s) + 0.15s) backwards; }
  .comp-capmap.is-in .rl-circle,
  .comp-capmap.is-in .rl-num { animation: rl-pop 0.35s var(--ease) calc(var(--rd, 0s) + 0.6s) backwards; }
  @keyframes rl-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes rl-grow {
    from { transform: scaleX(0); }
