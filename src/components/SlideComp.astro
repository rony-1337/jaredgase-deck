  /* hia · slide 4 "De-escalation by design": a looping story driven by the script.
     A question and an alert both route (wires) to support; support loads each
     content resource in turn, drawing a connector between them, then scans back
     and forth through them a few times ("processing"), and finally replies.
     States are toggled by class; CSS just tweens them. Positions are % of the
     1045x824 layout. */
  .comp-deesc { width: 100%; }
  .de-stage { position: relative; width: 100%; aspect-ratio: 1045 / 824; container-type: inline-size; }

  .comp-deesc .de-icon {
    position: absolute; height: auto; transform-origin: center;
    opacity: 0; transform: scale(0.6);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
  }
  .comp-deesc .de-icon.on { opacity: 1; transform: scale(1); }
  .comp-deesc .de-question { left: 6.5%;  top: 7%;   width: 22%; }
  .comp-deesc .de-ask      { left: 68%;   top: 9.5%; width: 22%; }
  .comp-deesc .de-support  { left: 37.5%; top: 51%;  width: 24%; }

  /* connector wires (drawn on) */
  .comp-deesc .de-wires { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; overflow: visible; }
  .comp-deesc .de-wire, .comp-deesc .de-arrow {
    fill: none; stroke: #9585b5; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 260; stroke-dashoffset: 260;
    transition: stroke-dashoffset 0.7s var(--ease);
  }
  .comp-deesc .de-arrow { stroke-dasharray: 52; stroke-dashoffset: 52; }
  .comp-deesc .de-wire.on, .comp-deesc .de-arrow.on { stroke-dashoffset: 0; }

  /* the content-resource row: icons with a drawn dotted segment between each */
  .comp-deesc .de-process {
    position: absolute; left: 22%; right: 20%; bottom: 5.5%;
    display: flex; align-items: center; z-index: 2;
  }
  .comp-deesc .de-step {
    position: static; flex: 0 0 auto; width: 5.6cqw; height: auto;
    transform-origin: center; opacity: 0; transform: scale(0.6);
    transition: opacity 0.4s var(--ease), transform 0.28s var(--ease);
  }
  .comp-deesc .de-step.loaded { opacity: 1; transform: scale(1); }
  .comp-deesc .de-step.scan { transform: scale(1.24); }
  .comp-deesc .de-seg {
    flex: 1 1 auto; height: 0; margin: 0 0.4cqw;
    border-top: 0.32cqw dotted #9585b5;
    transform: scaleX(0); transform-origin: left center;
    transition: transform 0.4s var(--ease);
  }
  .comp-deesc .de-seg.drawn { transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) {
    .comp-deesc .de-icon, .comp-deesc .de-step { opacity: 1; transform: none; }
    .comp-deesc .de-wire, .comp-deesc .de-arrow { stroke-dashoffset: 0; }
