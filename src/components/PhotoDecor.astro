---
// Decorative accents scattered around the about-me photos so the logo bubbles
// don't float alone: sparkles, confetti dots, rings, plus marks and a squiggle.
// Purely visual (aria-hidden). Each element carries its own position, color,
// size (--s), duration (--du) and delay (--dl) inline; the animation per type
// lives in the scoped style below.
const spark = "M12 0 C 13 7 17 11 24 12 C 17 13 13 17 12 24 C 11 17 7 13 0 12 C 7 11 11 7 12 0 Z";
interface Props {
  /** multiplier on every accent's size — smaller photos (e.g. gallery) use < 1 */
  scale?: number;
}
const { scale = 1 } = Astro.props;
---
<div class="fig-decor" aria-hidden="true" style={`--sc:${scale}`}>
  <!-- sparkles -->
  <svg class="dec spark" viewBox="0 0 24 24" style="color:#f4b740; top:-6%; left:10%;   --s:30px; --du:2.8s; --dl:0s"><path d={spark} /></svg>
  <svg class="dec spark" viewBox="0 0 24 24" style="color:#1e54e8; top:33%; right:-12%; --s:22px; --du:3.4s; --dl:.6s"><path d={spark} /></svg>
  <svg class="dec spark" viewBox="0 0 24 24" style="color:#ff6f61; bottom:6%; left:-10%; --s:24px; --du:3s;   --dl:1.1s"><path d={spark} /></svg>

  <!-- confetti dots -->
  <span class="dec dot" style="color:#ff6f61; top:9%;  left:-7%;   --s:14px; --du:4s;   --dl:.2s"></span>
  <span class="dec dot" style="color:#1e54e8; top:-4%; right:30%;  --s:11px; --du:4.4s; --dl:.8s"></span>
  <span class="dec dot" style="color:#2bb673; bottom:-4%; left:34%;--s:13px; --du:3.8s; --dl:.4s"></span>
  <span class="dec dot" style="color:#f4b740; bottom:26%; right:-9%;--s:12px; --du:4.2s; --dl:1.3s"></span>

  <!-- rings -->
  <span class="dec ring" style="color:#1e54e8; top:60%; left:-12%;  --s:28px; --du:5s;   --dl:.3s"></span>
  <span class="dec ring" style="color:#ff6f61; bottom:-7%; left:16%;--s:20px; --du:4.6s; --dl:.9s"></span>

  <!-- plus marks -->
  <svg class="dec plus" viewBox="0 0 20 20" style="color:#2bb673; top:47%; right:-12%; --s:22px; --du:3.2s; --dl:.5s"><path d="M10 2v16M2 10h16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
  <svg class="dec plus" viewBox="0 0 20 20" style="color:#f4b740; top:15%; left:-9%;   --s:18px; --du:3.6s; --dl:1.4s"><path d="M10 2v16M2 10h16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>

  <!-- squiggle -->
  <svg class="dec squiggle" viewBox="0 0 60 20" style="color:#1e54e8; top:-9%; right:6%; --s:66px; --du:5s; --dl:.2s"><path d="M2 10 Q 9 1 16 10 T 30 10 T 44 10 T 58 10" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
</div>

<style>
  .fig-decor { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  .dec { position: absolute; width: calc(var(--s, 20px) * var(--sc, 1)); }
  .spark, .plus { height: calc(var(--s, 20px) * var(--sc, 1)); fill: currentColor; }
  .squiggle { height: auto; }
  .dot  { height: calc(var(--s, 12px) * var(--sc, 1)); border-radius: 50%; background: currentColor; }
  .ring {
    height: calc(var(--s, 24px) * var(--sc, 1));
    border: calc(2.5px * var(--sc, 1)) solid currentColor; border-radius: 50%;
  }

  .spark    { animation: dec-twinkle var(--du, 3s) ease-in-out var(--dl, 0s) infinite; }
  .plus     { animation: dec-twinkle var(--du, 3s) ease-in-out var(--dl, 0s) infinite; }
  .dot      { animation: dec-drift   var(--du, 4s) ease-in-out var(--dl, 0s) infinite; }
  .ring     { animation: dec-pulse   var(--du, 5s) ease-in-out var(--dl, 0s) infinite; }
  .squiggle { animation: dec-wobble  var(--du, 5s) ease-in-out var(--dl, 0s) infinite; }

  @keyframes dec-twinkle {
    0%, 100% { transform: scale(0.55) rotate(0deg);  opacity: 0.35; }
    50%      { transform: scale(1.15) rotate(90deg); opacity: 1; }
  }
  @keyframes dec-drift {
    0%, 100% { transform: translate(0, 0);      opacity: 0.7; }
    50%      { transform: translate(4px, -16px); opacity: 1; }
  }
  @keyframes dec-pulse {
    0%, 100% { transform: scale(0.8);  opacity: 0.45; }
    50%      { transform: scale(1.12); opacity: 1; }
  }
  @keyframes dec-wobble {
    0%, 100% { transform: translateY(0) rotate(-7deg); }
    50%      { transform: translateY(-9px) rotate(7deg); }
  }
  @media (prefers-reduced-motion: reduce) { .dec { animation: none; } }
  @media (max-width: 48rem) { .fig-decor { display: none; } }
</style>
