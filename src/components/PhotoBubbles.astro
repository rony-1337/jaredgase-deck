---
// Floating "bubble" logos that orbit a photo. Sized in container units (cqw) so
// the same component works around a big overview portrait and the smaller panel
// gallery photos. The parent must be `position: relative`, `overflow: visible`,
// and `container-type: inline-size`.
//
// Each bubble floats on its OWN timeline — a unique duration, starting phase,
// drift amplitude, and rotation — so no two ever move in sync. The values are
// deterministically seeded from the logo path, so they're stable across renders
// but different for every bubble.
interface Props {
  logos: string[];
}
const { logos } = Astro.props;

function seeded(str: string) {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return () => {
    h += 0x6d2b79f5;
    let t = h;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const bubbles = logos.map((logo, i) => {
  const r = seeded(logo + "|" + i);
  const dir = r() < 0.5 ? -1 : 1;
  const sx = r() < 0.5 ? -1 : 1;
  return {
    logo,
    dur: (3.4 + r() * 2.8).toFixed(2), // 3.4–6.2s
    delay: (-(r() * 6)).toFixed(2), // -0 to -6s → random starting phase
    dx: (sx * (5 + r() * 9)).toFixed(1), // ±5–14px
    dy: (-(11 + r() * 13)).toFixed(1), // -11 to -24px (drifts up)
    rot: (dir * (3 + r() * 6)).toFixed(1), // ±3–9deg
  };
});
---
<ul class="pb" aria-hidden="true">
  {bubbles.map((b) => (
    <li
      class="pb-item"
      style={`--dur:${b.dur}s; --delay:${b.delay}s; --dx:${b.dx}px; --dy:${b.dy}px; --rot:${b.rot}deg;`}
    >
      <img src={b.logo} alt="" loading="lazy" />
    </li>
  ))}
</ul>

<style>
  .pb { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; pointer-events: none; z-index: 3; }
  .pb-item {
    position: absolute;
    width: clamp(44px, 24cqw, 116px); aspect-ratio: 1;
    display: grid; place-items: center;
    background: #fff; border: 1px solid var(--line);
    border-radius: 50%;
    box-shadow: 0 16px 32px -12px rgba(17, 21, 28, 0.44);
    animation: pb-float var(--dur, 4s) ease-in-out var(--delay, 0s) infinite;
  }
  .pb-item img { width: 60%; height: 60%; object-fit: contain; }
  /* scatter around the photo's perimeter */
  .pb-item:nth-child(1) { top: 1%;    right: -9%; }
  .pb-item:nth-child(2) { top: 40%;   left: -11%; }
  .pb-item:nth-child(3) { bottom: 1%; right: -7%; }
  /* per-bubble path: amplitude, drift and rotation all come from CSS vars */
  @keyframes pb-float {
    0%, 100% { transform: translate(0, 0) rotate(calc(var(--rot, 5deg) * -1)); }
    30%      { transform: translate(var(--dx, 6px), var(--dy, -18px)) rotate(var(--rot, 5deg)); }
    65%      { transform: translate(calc(var(--dx, 6px) * -0.5), calc(var(--dy, -18px) * 0.45)) rotate(calc(var(--rot, 5deg) * -0.4)); }
  }
  @media (prefers-reduced-motion: reduce) { .pb-item { animation: none; } }
  @media (max-width: 48rem) { .pb { display: none; } }
</style>
