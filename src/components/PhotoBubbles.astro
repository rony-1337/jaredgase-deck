---
// Floating "bubble" logos that orbit a photo. Sized in container units (cqw) so
// the same component works around a big overview portrait and the smaller panel
// gallery photos. Parent must be position:relative, overflow:visible,
// container-type:inline-size.
//
// Every bubble is independent: a randomly chosen motion PATH (six distinct
// named keyframes, not one shared timeline), its own duration, starting phase,
// and a scattered position around the photo's perimeter. All seeded from the
// logo path so it's stable across renders but different for each bubble.
interface Props {
  logos: string[];
}
const { logos } = Astro.props;

function seeded(str: string) {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return () => {
    h += 0x6d2b79f5;
    let t = h;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// perimeter anchor points (bubble's top-left corner, % of container) — spill out
const ANCHORS = [
  { top: -7, left: -8 }, // top-left
  { top: -6, left: 80 }, // top-right
  { top: 34, left: 88 }, // right
  { top: 78, left: 76 }, // bottom-right
  { top: 76, left: -10 }, // bottom-left
  { top: 34, left: -13 }, // left
];
const VARIANTS = ["a", "b", "c", "d", "e", "f"];

// seeded shuffle of the anchors for THIS photo, so each photo scatters differently
const sh = seeded("anchor|" + logos.join("|"));
const anchors = ANCHORS.map((a) => ({ a, k: sh() }))
  .sort((x, y) => x.k - y.k)
  .map((o) => o.a);

const bubbles = logos.map((logo, i) => {
  const r = seeded(logo + "|" + i);
  const a = anchors[i % anchors.length];
  return {
    logo,
    v: VARIANTS[Math.floor(r() * VARIANTS.length)],
    dur: (3.6 + r() * 3.2).toFixed(2), // 3.6–6.8s
    delay: (-(r() * 7)).toFixed(2), // random starting phase
    top: (a.top + (r() * 10 - 5)).toFixed(1),
    left: (a.left + (r() * 8 - 4)).toFixed(1),
  };
});
---
<ul class="pb" aria-hidden="true">
  {bubbles.map((b) => (
    <li
      class={`pb-item pb-${b.v}`}
      style={`top:${b.top}%; left:${b.left}%; animation-duration:${b.dur}s; animation-delay:${b.delay}s;`}
    >
      <img src={b.logo} alt="" loading="lazy" />
    </li>
  ))}
</ul>

<style>
  .pb { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; pointer-events: none; z-index: 3; }
  .pb-item {
    position: absolute;
    width: clamp(44px, 24cqw, 116px); aspect-ratio: 1;
    display: grid; place-items: center;
    background: #fff; border: 1px solid var(--line);
    border-radius: 50%;
    box-shadow: 0 16px 32px -12px rgba(17, 21, 28, 0.44);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-duration: 4s; /* overridden inline per bubble */
  }
  .pb-item img { width: 60%; height: 60%; object-fit: contain; }

  /* six genuinely different drift paths — assigned per bubble via class so
     Astro's keyframe scoping still resolves (inline animation-name would not) */
  .pb-a { animation-name: pb-a; }
  .pb-b { animation-name: pb-b; }
  .pb-c { animation-name: pb-c; }
  .pb-d { animation-name: pb-d; }
  .pb-e { animation-name: pb-e; }
  .pb-f { animation-name: pb-f; }

  @keyframes pb-a {
    0%, 100% { transform: translate(0, 0) rotate(-4deg); }
    50%      { transform: translate(7px, -20px) rotate(6deg); }
  }
  @keyframes pb-b {
    0%, 100% { transform: translate(0, 0) rotate(5deg); }
    50%      { transform: translate(-9px, -15px) rotate(-6deg); }
  }
  @keyframes pb-c {
    0%, 100% { transform: translate(0, -3px) rotate(-3deg); }
    33%      { transform: translate(10px, -11px) rotate(5deg); }
    66%      { transform: translate(-7px, -19px) rotate(-2deg); }
  }
  @keyframes pb-d {
    0%, 100% { transform: translate(0, 0) rotate(2deg); }
    25%      { transform: translate(-6px, -23px) rotate(-7deg); }
    60%      { transform: translate(6px, -7px) rotate(6deg); }
  }
  @keyframes pb-e {
    0%, 100% { transform: translate(0, 0) rotate(3deg); }
    40%      { transform: translate(12px, -13px) rotate(-5deg); }
    72%      { transform: translate(3px, -25px) rotate(7deg); }
  }
  @keyframes pb-f {
    0%, 100% { transform: translate(0, 0) rotate(-6deg); }
    50%      { transform: translate(-11px, -12px) rotate(8deg); }
  }

  @media (prefers-reduced-motion: reduce) { .pb-item { animation: none; } }
  @media (max-width: 48rem) { .pb { display: none; } }
</style>
