---
// Persistent top chrome for the parallax site: wordmark left (with the current
// view appended, e.g. "Jared Gase / Overview"), a small status cluster
// (location + live local clock) center, and a Views hamburger right that opens
// a dropdown of the other views. Fixed and transparent so it rides over both
// warm-paper and navy scenes. Uses currentColor so a scene can invert it.
import { site, modes } from "../data/site";

interface Props {
  /** slug of the view this page represents; drives the wordmark suffix and
   *  which options the Views dropdown offers (all others). */
  current?: string;
  /** extra breadcrumb after the view, e.g. the individual case-study name */
  detail?: string;
}
const { current, detail } = Astro.props;
const place = site.location.split(",")[0].toUpperCase();
const currentMode = modes.find((m) => m.slug === current);
// Customize (the live mode) is disabled for now, so it stays out of the dropdown.
const otherModes = modes.filter((m) => m.slug !== current && !m.live);
---

<header class="chrome">
  <div class="chrome-brand">
    <a class="chrome-mark" href="/" aria-label={`${site.name}, back to start`}>
      <img class="chrome-logo" src="/favicon.svg" alt="" width="26" height="26" />
      <span class="chrome-name">{site.name}</span>
    </a>
    {currentMode && (
      <a class="chrome-cur chrome-cur-link" href={currentMode.href}>/ {currentMode.navLabel}</a>
    )}
    {detail && <span class="chrome-cur chrome-detail" aria-current="page">/ {detail}</span>}
  </div>

  <div class="chrome-status" aria-hidden="true">
    <span class="chrome-place">{place}</span>
    <span class="chrome-dot">·</span>
    <span class="chrome-clock" data-clock>--:--</span>
  </div>

  <details class="chrome-menu">
    <summary class="chrome-views" aria-label="Views">
      <span>Views</span>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none" />
      </svg>
    </summary>
    <ul class="chrome-drop">
      {otherModes.map((m) => (
        <li>
          <a href={m.href} class:list={[m.live && "is-live"]}>
            <span class="chrome-drop-lead">
              {m.live && (
                <span class="chrome-ping" aria-hidden="true"><span class="chrome-ping-dot"></span></span>
              )}
              <span class="chrome-drop-name">{m.navLabel}</span>
            </span>
            <span class="chrome-drop-time">{m.time}</span>
          </a>
        </li>
      ))}
    </ul>
  </details>
</header>

<script>
  // live local clock in the chrome (self-contained so the header works on
  // pages that do not load the full parallax engine)
  const clocks = document.querySelectorAll<HTMLElement>("[data-clock]");
  if (clocks.length) {
    const tick = () => {
      const t = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hour12: false });
      clocks.forEach((el) => (el.textContent = t));
    };
    tick();
    setInterval(tick, 15_000);
  }

  // close any open Views dropdown on outside click or Escape
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>(".chrome-menu[open]").forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    document.querySelectorAll<HTMLDetailsElement>(".chrome-menu[open]").forEach((d) => (d.open = false));
  });
</script>

<style>
  .chrome {
    /* the bar is always a light frosted veil, so lock text to the light-theme
       ink values even on dark-theme pages (e.g. Customize) */
    --ink: #16181c;
    --ink-soft: #5b6069;
    --ink-faint: #8c8f96;
    --line: #e3e0d7;
    --accent-ink: #163fb0;
    --accent-wash: #eef2fe;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4) clamp(16px, 4.5vw, 64px);
    color: var(--ink);
    /* frosted white veil so the nav stays legible over any scene, including
       the dark navy ones (the andrewcunliffe.ai treatment) */
    background: color-mix(in srgb, #ffffff 62%, transparent);
    backdrop-filter: saturate(1.3) blur(14px);
    -webkit-backdrop-filter: saturate(1.3) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .chrome { background: color-mix(in srgb, #ffffff 88%, transparent); }
  }
  .chrome-brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
  }
  .chrome-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 0.95rem;
  }
  .chrome-logo {
    width: 26px;
    height: 26px;
    border-radius: 50%;
  }
  .chrome-cur {
    font-weight: 500;
    letter-spacing: -0.01em;
    font-size: 0.95rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .chrome-cur-link { transition: color 0.15s var(--ease); }
  .chrome-cur-link:hover { color: var(--accent-ink); }
  .chrome-detail { overflow: hidden; text-overflow: ellipsis; max-width: 34ch; }
  @media (max-width: 52rem) {
    .chrome-detail { display: none; }
  }
  @media (max-width: 40rem) {
    /* mark shows only the logo; keep the current-view label for context */
    .chrome-name { display: none; }
  }
  .chrome-status {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }
  .chrome-dot { opacity: 0.5; }
  .chrome-clock { font-variant-numeric: tabular-nums; min-width: 4ch; }
  /* Views hamburger + dropdown (native <details>, no framework) */
  .chrome-menu { justify-self: end; position: relative; }
  .chrome-views {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: pointer;
    list-style: none;
    transition: color 0.2s var(--ease);
  }
  .chrome-views::-webkit-details-marker { display: none; }
  .chrome-menu[open] .chrome-views,
  .chrome-views:hover { color: var(--accent-ink); }

  .chrome-drop {
    position: absolute;
    top: calc(100% + var(--s-3));
    right: 0;
    min-width: 17rem;
    padding: var(--s-2);
    background: color-mix(in srgb, #ffffff 84%, transparent);
    backdrop-filter: saturate(1.3) blur(16px);
    -webkit-backdrop-filter: saturate(1.3) blur(16px);
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    border-radius: var(--radius-s);
    box-shadow: 0 16px 44px -22px rgba(17, 21, 28, 0.4);
    display: grid;
    gap: 2px;
  }
  .chrome-drop a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: var(--s-3) var(--s-3);
    border-radius: calc(var(--radius-s) - 4px);
    white-space: nowrap;
    transition: background 0.15s var(--ease), color 0.15s var(--ease);
  }
  .chrome-drop a:hover { background: var(--accent-wash); }
  .chrome-drop-lead { display: inline-flex; align-items: center; gap: var(--s-2); }
  .chrome-drop-name { font-weight: 600; font-size: var(--t-small); letter-spacing: -0.01em; }
  .chrome-drop a:hover .chrome-drop-name { color: var(--accent-ink); }
  .chrome-drop-time {
    font-family: var(--font-mono); font-size: var(--t-label);
    letter-spacing: 0.04em; color: var(--ink-faint);
  }

  /* the live "Customize" option, styled to stand out like the home-page card */
  .chrome-drop a.is-live {
    background: color-mix(in srgb, var(--accent-wash) 70%, transparent);
  }
  .chrome-drop a.is-live:hover { background: var(--accent-wash); }
  .chrome-drop a.is-live .chrome-drop-name { color: var(--accent-ink); }
  .chrome-ping { display: grid; place-items: center; width: 12px; height: 12px; flex: none; }
  .chrome-ping-dot { position: relative; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .chrome-ping-dot::after {
    content: ""; position: absolute; inset: -4px; border-radius: 50%;
    border: 1.5px solid var(--accent); animation: chromePing 1.8s var(--ease) infinite;
  }
  @keyframes chromePing {
    0% { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(1.7); opacity: 0; }
  }

  @media (max-width: 40rem) {
    .chrome-status { display: none; }
    .chrome { grid-template-columns: 1fr auto; }
  }
</style>
