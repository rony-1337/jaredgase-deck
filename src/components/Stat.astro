---
interface Props {
  value: string;
  suffix?: string;
  label: string;
}
const { value, suffix, label } = Astro.props;
---

<div class="stat">
  <div class="stat-val">{value}{suffix && <span class="stat-suf">{suffix}</span>}</div>
  <div class="stat-lab">{label}</div>
</div>

<style>
  .stat-val {
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }
  .stat-suf {
    font-size: 0.55em;
    color: var(--ink-faint);
    font-weight: 600;
  }
  .stat-lab {
    margin-top: 6px;
    font-size: var(--t-small);
    color: var(--ink-soft);
    line-height: 1.35;
    max-width: 22ch;
  }
</style>
