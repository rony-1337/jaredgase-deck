---
// Scroll engine. Dependency-free. Drop once per page.
//  - [data-parallax] with data-speed-x / data-speed-y drifts on both axes as it
//    crosses the viewport (the bi-axis depth from the reference).
//  - [data-reveal] fades/rises in via IntersectionObserver (toggles .is-in).
//  - [data-clock] gets a live local time, updated each minute.
// All motion is gated on prefers-reduced-motion: reduce.
---

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  // --- live clock in the chrome -------------------------------------------
  function startClock() {
    const els = document.querySelectorAll<HTMLElement>("[data-clock]");
    if (!els.length) return;
    const tick = () => {
      const t = new Date().toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      });
      els.forEach((el) => (el.textContent = t));
    };
    tick();
    setInterval(tick, 15_000);
  }

  // --- reveal-on-enter -----------------------------------------------------
  function startReveals() {
    const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (!els.length) return;
    if (reduce.matches) {
      els.forEach((el) => el.classList.add("is-in"));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  }

  // --- bi-axis parallax drift ---------------------------------------------
  function startParallax() {
    const els = Array.from(
      document.querySelectorAll<HTMLElement>("[data-parallax]"),
    );
    if (!els.length || reduce.matches) return;

    let vh = window.innerHeight;
    let ticking = false;

    const update = () => {
      ticking = false;
      const mid = vh / 2;
      for (const el of els) {
        const r = el.getBoundingClientRect();
        // progress: -1 when the element's center sits a viewport below the
        // fold, 0 at center, +1 a viewport above. Clamped.
        const center = r.top + r.height / 2;
        let p = (center - mid) / (mid + r.height / 2);
        if (p < -1) p = -1;
        else if (p > 1) p = 1;
        const sx = parseFloat(el.dataset.speedX || "0");
        const sy = parseFloat(el.dataset.speedY || "0");
        // negative progress (element below center) pushes positive offset, so
        // a positive speed means "trails up/left as you scroll down".
        el.style.setProperty("--tx", `${(-p * sx).toFixed(2)}px`);
        el.style.setProperty("--ty", `${(-p * sy).toFixed(2)}px`);
      }
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener(
      "resize",
      () => {
        vh = window.innerHeight;
        onScroll();
      },
      { passive: true },
    );
    update();
  }

  // --- horizontal-scroll sections: vertical scroll drives left-to-right ----
  // Generic across every [data-hscroll] section (My Journey and each case
  // study). Each pins, slides its track by scroll progress, optionally drives a
  // timeline, and snaps to the nearest panel once scrolling settles.
  function initHScroll(sec: HTMLElement) {
    const track = sec.querySelector<HTMLElement>("[data-hscroll-track]");
    if (!track) return;
    const n = track.children.length;
    if (n < 2 || reduce.matches) return;
    const fill = sec.querySelector<HTMLElement>(".tl-fill");
    const dots = Array.from(sec.querySelectorAll<HTMLElement>(".tl-marks li"));
    let ticking = false;
    let snapTimer: number | undefined;
    let snapping = false;

    const update = () => {
      ticking = false;
      const total = sec.offsetHeight - window.innerHeight;
      const scrolled = Math.min(Math.max(-sec.getBoundingClientRect().top, 0), Math.max(total, 0));
      const p = total > 0 ? scrolled / total : 0;
      const maxX = track.scrollWidth - window.innerWidth;
      track.style.transform = `translate3d(${(-p * maxX).toFixed(1)}px, 0, 0)`;
      if (fill) fill.style.width = `${(p * 100).toFixed(2)}%`;
      if (dots.length) {
        const active = Math.round(p * (n - 1));
        dots.forEach((d, k) => {
          d.classList.toggle("on", k === active);
          d.classList.toggle("past", k < active);
        });
      }
    };
    // A "snapping" lock held until the scroll actually arrives stops it from
    // re-firing mid-animation (which caused earlier jitter).
    const snapToPanel = () => {
      const total = sec.offsetHeight - window.innerHeight;
      const rectTop = sec.getBoundingClientRect().top;
      if (total <= 0 || rectTop > 0 || rectTop < -total) return; // only while pinned
      const p = Math.min(Math.max(-rectTop, 0), total) / total;
      const k = Math.round(p * (n - 1));
      const targetY = Math.round(sec.offsetTop + (k / (n - 1)) * total);
      if (Math.abs(targetY - window.scrollY) < 4) return; // already on a panel
      snapping = true;
      window.scrollTo({ top: targetY, behavior: "smooth" });
      const t0 = performance.now();
      const settle = () => {
        if (Math.abs(window.scrollY - targetY) < 4 || performance.now() - t0 > 700) snapping = false;
        else requestAnimationFrame(settle);
      };
      requestAnimationFrame(settle);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
      if (!snapping) {
        clearTimeout(snapTimer);
        snapTimer = window.setTimeout(snapToPanel, 150);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  function startHScroll() {
    document.querySelectorAll<HTMLElement>("[data-hscroll]").forEach(initHScroll);
  }

  const boot = () => {
    startClock();
    startReveals();
    startParallax();
    startHScroll();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>
