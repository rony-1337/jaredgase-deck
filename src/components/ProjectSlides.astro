---
// PDF-style presentation slides for a case study: one full-screen snap scene
// per slide, image on one side, eyebrow + title + high-level bullets on the
// other. Speaker notes live in a closed-by-default accordion on each slide,
// and a persistent "Present" button pops out a speaker-notes window that
// follows along as the deck scrolls.
import SlideComp from "./SlideComp.astro";
import type { DeckSlide } from "../data/slides/types";

interface Props {
  slides: DeckSlide[];
  /** deck name shown in the presenter popup title */
  title?: string;
  /** show the "01 / 09" counter beside each eyebrow (off for explainer decks) */
  counter?: boolean;
}
const { slides, title = "Speaker notes", counter = true } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const isVideo = (u: string) => /\.(mp4|webm|mov)$/i.test(u);

// payload for the presenter popup. Decks with no notes (explainer sets) skip
// the popup and its trigger entirely.
const hasNotes = slides.some((s) => Boolean(s.notes));
const notesData = slides.map((s, i) => ({
  n: pad(i + 1),
  eyebrow: s.eyebrow ?? "",
  title: s.title,
  notes: s.notes ?? "",
}));
---

{slides.map((s, i) => {
  const side = s.side ?? (i % 2 === 1 ? "left" : "right");
  const isStats = !!s.stats?.length;
  const isColumns = !!s.columns?.length;
  const isGallery = !!s.gallery?.length;
  const isFull = s.layout === "full";
  const isCenter = s.layout === "center";
  const isSolo = isStats || isColumns || isGallery;
  return (
    <section
      class="scene scene--full snap slide-scene"
      data-slide-idx={i}
      aria-label={`Slide ${i + 1}: ${s.title}`}
    >
      <div class="scene-inner">
        <div class={isSolo ? `slide-solo ${isGallery ? "slide-solo--gallery" : ""}` : isCenter ? "slide-center" : isFull ? "slide-stack" : `slide-grid ${side === "left" ? "is-left" : ""}`}>
        {!isSolo && s.comp && (
          <figure class={`slide-figure slide-figure--comp comp--${s.comp}`}>
            <SlideComp name={s.comp} />
          </figure>
        )}
        {!isSolo && !s.comp && (
          <figure class={`slide-figure ${s.video ? "slide-figure--video" : ""}`} data-reveal data-from={side === "left" ? "left" : "right"}>
            {s.video ? (
              <iframe
                src={s.video}
                title={s.title}
                loading="lazy"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              ></iframe>
            ) : s.img ? (
              isVideo(s.img) ? (
                <video src={s.img} autoplay muted loop playsinline preload="metadata" />
              ) : (
                <img src={s.img} alt={s.title} loading="lazy" />
              )
            ) : (
              <div class="slide-ph">
                <span class="slide-ph-tag">Asset needed</span>
                <span class="slide-ph-note">{s.ph}</span>
              </div>
            )}
          </figure>
        )}

        <div class="slide-copy">
          {s.eyebrow && (
            <p class="eyebrow slide-eyebrow" data-reveal data-from={side === "left" ? "right" : "left"}>
              <span class="slide-kicker">{s.eyebrow}</span>
              {counter && <span class="slide-count">{pad(i + 1)} / {pad(slides.length)}</span>}
            </p>
          )}
          <h2 class={`slide-title ${isFull || isGallery ? "slide-title--full" : ""}`} data-reveal data-from={side === "left" ? "right" : "left"} style="--reveal-delay:80ms">{s.title}</h2>
          {s.lede && <p class="slide-lede" data-reveal data-from={side === "left" ? "right" : "left"} style="--reveal-delay:160ms">{s.lede}</p>}

          {s.display && (
            <p class="slide-display" data-reveal data-from={side === "left" ? "right" : "left"} style="--reveal-delay:240ms">
              {s.display.map((line) => <span>{line}</span>)}
            </p>
          )}

          {isStats && (
            <ul class="slide-stats" data-reveal style="--reveal-delay:200ms">
              {s.stats!.map((m) => (
                <li>
                  <p class="slide-stat-val">{m.value}</p>
                  <p class="slide-stat-label">{m.label}</p>
                </li>
              ))}
            </ul>
          )}

          {isGallery && (
            <ul class="slide-gallery" data-reveal style="--reveal-delay:200ms">
              {s.gallery!.map((g, k) => (
                <li style={`--reveal-delay:${200 + k * 130}ms`}>
                  <img src={g.img} alt={g.alt} loading="lazy" />
                  <p>{g.caption}</p>
                </li>
              ))}
            </ul>
          )}

          {isColumns && (
            <ul class="slide-cols" data-reveal style="--reveal-delay:200ms">
              {s.columns!.map((c, k) => (
                <li style={`--reveal-delay:${200 + k * 120}ms`}>
                  <img class="slide-col-icon" src={c.icon} alt="" width="99" height="100" loading="lazy" />
                  <h3 class="slide-col-title">{c.title}</h3>
                  <p class="slide-col-blurb">{c.blurb}</p>
                </li>
              ))}
            </ul>
          )}

          {s.bullets && (
            <ul class="slide-list" data-reveal style="--reveal-delay:220ms">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}

          {s.groups && (
            <div class="slide-groups" data-reveal style="--reveal-delay:220ms">
              {s.groups.map((g) => (
                <div class="slide-group">
                  <p class="slide-group-label">{g.label}</p>
                  <ul class="slide-list">
                    {g.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          )}

        </div>
        </div>

        {s.notes && (
          <details class="slide-notes" data-reveal style="--reveal-delay:300ms">
            <summary>Additional info</summary>
            <p>{s.notes}</p>
          </details>
        )}
      </div>
    </section>
  );
})}

<!-- presenter control (only on decks that carry notes). A labeled tab docked at
     the middle-left edge: peeks a few px at rest, and on hover / keyboard focus
     the whole tab slides out and IS the button — clicking it opens the speaker-
     notes window (data-present). Off the bottom-right corner, which the global
     mode toggle owns. -->
{hasNotes && (
  <div class="notes-dock">
    <button class="notes-tab" type="button" data-present aria-label="Open speaker notes">
    <span class="notes-tab-icon" aria-hidden="true">
      <svg width="21" height="21" viewBox="0 0 40 40" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M24.8655 14.5284C24.8655 14.0895 24.5234 13.7329 24.1024 13.7329H5.68308C5.26203 13.7329 4.91992 14.0895 4.91992 14.5284C4.91992 14.9691 5.26203 15.324 5.68308 15.324H24.1007C24.5234 15.324 24.8655 14.9674 24.8655 14.5284Z" />
        <path d="M23.0359 20.9374C23.0359 20.4985 22.6938 20.1419 22.2728 20.1419L5.67917 20.1401C5.25812 20.1401 4.91602 20.4968 4.91602 20.9357C4.91602 21.3763 5.25812 21.7312 5.67917 21.7312H22.2711C22.6938 21.7329 23.0359 21.3763 23.0359 20.9374Z" />
        <path d="M19.3812 27.3478C19.3812 26.9089 19.0391 26.5522 18.6181 26.5522H5.67917C5.25812 26.5522 4.91602 26.9089 4.91602 27.3478C4.91602 27.7884 5.25812 28.1433 5.67917 28.1433H18.6181C19.0408 28.145 19.3812 27.7884 19.3812 27.3478Z" />
        <path d="M5.67917 32.978C5.25812 32.978 4.91602 33.3346 4.91602 33.7736C4.91602 34.2142 5.25812 34.5691 5.67917 34.5691H18.3747C18.7958 34.5691 19.1379 34.2125 19.1379 33.7736C19.1379 33.3329 18.7958 32.978 18.3747 32.978H5.67917Z" />
        <path d="M29.0234 33.0969C28.6023 33.0969 28.2602 33.4535 28.2602 33.8924V36.7728C28.2602 37.6747 27.5579 38.4068 26.6928 38.4068L3.09413 38.4085C2.229 38.4085 1.52668 37.6764 1.52668 36.7745V8.91201H28.2584V11.1409C28.2584 11.5798 28.6005 11.9364 29.0215 11.9364C29.4442 11.9364 29.7847 11.5798 29.7847 11.1409L29.7863 5.60481C29.7863 3.55423 28.1876 1.8877 26.2205 1.8877H24.4755L24.4771 0.795539C24.4771 0.356621 24.135 0 23.714 0C23.2913 0 22.9508 0.356621 22.9508 0.795539V1.8877H18.5955V0.795539C18.5955 0.356621 18.2534 0 17.8323 0C17.4096 0 17.0692 0.356621 17.0692 0.795539V1.8877H12.7155V0.795539C12.7155 0.356621 12.3734 0 11.9523 0C11.5296 0 11.1892 0.356621 11.1892 0.795539V1.8877H6.83551V0.795539C6.83551 0.356621 6.49341 0 6.07235 0C5.64966 0 5.3092 0.356621 5.3092 0.795539V1.8877H3.09376C1.38816 1.8877 0 3.33477 0 5.11274V36.775C0 38.5529 1.38816 40 3.09376 40H26.6924C28.398 40 29.7862 38.5529 29.7862 36.775V33.8946C29.7862 33.4539 29.4441 33.0973 29.023 33.0973L29.0234 33.0969ZM3.09421 3.47869H5.30966V4.49026C5.30966 4.92918 5.65176 5.2858 6.07281 5.2858C6.49551 5.2858 6.83597 4.92918 6.83597 4.49026V3.47869H11.1896V4.49026C11.1896 4.92918 11.5317 5.2858 11.9528 5.2858C12.3755 5.2858 12.7159 4.92918 12.7159 4.49026V3.47869H17.0696V4.49026C17.0696 4.92918 17.4117 5.2858 17.8328 5.2858C18.2555 5.2858 18.5959 4.92918 18.5959 4.49026V3.47869H22.9496V4.49026C22.9496 4.92918 23.2917 5.2858 23.7127 5.2858C24.1354 5.2858 24.4759 4.92918 24.4759 4.49026V3.47869H26.2209C27.346 3.47869 28.2587 4.43197 28.2587 5.60296V7.31746L1.52875 7.31918V5.1126C1.52875 4.21247 2.23072 3.47869 3.09421 3.47869Z" />
        <path d="M39.9676 12.9649C39.8656 12.3134 39.5252 11.7424 39.012 11.3567L36.2176 9.26326C35.1584 8.47285 33.6732 8.72145 32.9051 9.82735L21.8576 25.8566C21.2063 26.8013 20.8543 27.9158 20.8411 29.0817L20.7852 33.6012C20.7819 33.8618 20.9004 34.107 21.1027 34.2579C21.2342 34.3556 21.3905 34.407 21.5484 34.407C21.6323 34.407 21.7194 34.3933 21.8017 34.3625L25.8954 32.8674C26.9513 32.4817 27.8526 31.7787 28.504 30.834L39.5515 14.8065C39.9216 14.2715 40.0696 13.6164 39.9676 12.9649ZM27.262 29.9063C26.7948 30.5852 26.1468 31.0893 25.3886 31.3653L22.3261 32.4849L22.3656 29.1022C22.3771 28.2655 22.6288 27.4631 23.0975 26.7876L32.2078 13.5722L36.3723 16.6909L27.262 29.9063ZM38.3112 13.877L37.2635 15.396L33.099 12.2756L34.1467 10.7565C34.3112 10.5182 34.5711 10.3913 34.8326 10.3913C35.0036 10.3913 35.1763 10.4445 35.3244 10.5559L38.1188 12.6494C38.303 12.7865 38.423 12.9888 38.4592 13.222C38.4954 13.4535 38.4428 13.6867 38.3112 13.877Z" />
      </svg>
    </span>
    <span class="notes-tab-label">Presenters notes</span>
    </button>
  </div>
)}

{hasNotes && (
  <script type="application/json" id="slide-notes-data" set:html={JSON.stringify({ title, notes: notesData })} />
)}

<script>
  const dataEl = document.getElementById("slide-notes-data");
  const btn = document.querySelector<HTMLButtonElement>("[data-present]");
  const scenes = Array.from(document.querySelectorAll<HTMLElement>(".slide-scene"));
  if (dataEl && btn && scenes.length) {
    const { title, notes } = JSON.parse(dataEl.textContent || "{}");
    let win: Window | null = null;
    let active = 0;

    const popupHtml = `<!doctype html><html><head><meta charset="utf-8"><title>${title}</title>
      <style>
        body { margin: 0; font-family: "Hanken Grotesk", system-ui, sans-serif; background: #13314f; color: #eef1f6; }
        header { position: sticky; top: 0; background: #0e2740; padding: 12px 18px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #9db2c9; }
        main { padding: 10px 14px 24px; }
        article { padding: 14px 14px; margin-top: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,.08); opacity: .45; transition: opacity .2s; }
        article.on { opacity: 1; background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.22); }
        .k { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #7fa4ff; }
        h2 { margin: 6px 0 8px; font-size: 15px; line-height: 1.25; }
        p { margin: 0; font-size: 13.5px; line-height: 1.55; color: #c8d2e0; }
      </style></head><body>
      <header>${title}</header>
      <main>
        ${notes.map((s: any) => `<article data-i="${s.n}"><span class="k">${s.n} · ${s.eyebrow}</span><h2>${s.title}</h2><p>${s.notes}</p></article>`).join("")}
      </main></body></html>`;

    const syncPopup = () => {
      if (!win || win.closed) return;
      const arts = win.document.querySelectorAll("article");
      arts.forEach((a, k) => a.classList.toggle("on", k === active));
      const on = arts[active];
      if (on) on.scrollIntoView({ block: "center", behavior: "smooth" });
    };

    btn.addEventListener("click", () => {
      if (win && !win.closed) { win.focus(); return; }
      win = window.open("", "speaker-notes", "width=440,height=720");
      if (!win) return;
      win.document.open();
      win.document.write(popupHtml);
      win.document.close();
      syncPopup();
    });

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            active = Number((e.target as HTMLElement).dataset.slideIdx || 0);
            syncPopup();
          }
        }
      },
      { threshold: 0.55 },
    );
    scenes.forEach((s) => io.observe(s));
  }

  // stats count up (or down, for negative values) when the Results slide
  // arrives. Values parse as [sign][number][suffix], e.g. "-5%" or "+1.1".
  const reduceStats = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduceStats.matches) {
    const vals = Array.from(document.querySelectorAll<HTMLElement>(".slide-stat-val"));
    const parsed = vals
      .map((el) => {
        const m = (el.textContent || "").trim().match(/^([+-]?)(\d+(?:\.\d+)?)(.*)$/);
        if (!m) return null;
        const decimals = (m[2].split(".")[1] || "").length;
        // hold the start value so the final number never flashes early
        el.textContent = `${m[1]}${(0).toFixed(decimals)}${m[3]}`;
        return { el, sign: m[1], target: parseFloat(m[2]), suffix: m[3], decimals };
      })
      .filter((x): x is NonNullable<typeof x> => Boolean(x));

    const runCount = (s: (typeof parsed)[number]) => {
      const dur = 1300;
      const t0 = performance.now();
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
      const step = (now: number) => {
        const p = Math.min((now - t0) / dur, 1);
        s.el.textContent = `${s.sign}${(s.target * easeOut(p)).toFixed(s.decimals)}${s.suffix}`;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const statIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          statIo.unobserve(e.target);
          parsed
            .filter((s) => e.target.contains(s.el))
            .forEach((s, k) => window.setTimeout(() => runCount(s), 250 + k * 120));
        }
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll(".slide-stats").forEach((ul) => statIo.observe(ul));
  }

  // Force captions off on YouTube embeds: cc_load_policy only sets the default,
  // so unload the caption module through the IFrame API once the player loads.
  document.querySelectorAll<HTMLIFrameElement>('iframe[src*="youtube.com"]').forEach((f) => {
    const kill = () => {
      const win = f.contentWindow;
      if (!win) return;
      for (const mod of ["captions", "cc"]) {
        win.postMessage(JSON.stringify({ event: "command", func: "unloadModule", args: [mod] }), "*");
      }
    };
    f.addEventListener("load", () => [300, 1000, 2000, 3500].forEach((t) => window.setTimeout(kill, t)));
  });
</script>

<style is:global>
  /* about-me gallery: the three photos land stacked like a deck of cards in
     the middle, hold for a beat, then fan out to their columns one by one.
     (html.js-prefixed selectors do not survive Astro's style scoping, so the
     pre-reveal state has to live in a global block.) */
  .slide-gallery li { transition: transform 0.85s var(--ease); }
  html.js .slide-gallery:not(.is-in) li:nth-child(1) { transform: translateX(106%) rotate(-5deg); }
  html.js .slide-gallery:not(.is-in) li:nth-child(2) { transform: rotate(2.5deg); }
  html.js .slide-gallery:not(.is-in) li:nth-child(3) { transform: translateX(-106%) rotate(5deg); }
  .slide-gallery.is-in li:nth-child(1) { transition-delay: 0.9s; }
  .slide-gallery.is-in li:nth-child(2) { transition-delay: 1.15s; }
  .slide-gallery.is-in li:nth-child(3) { transition-delay: 1.4s; }
  @media (prefers-reduced-motion: reduce) {
    html.js .slide-gallery:not(.is-in) li { transform: none; }
    .slide-gallery li { transition: none; }
  }
</style>

<style>
  /* scene scaffold: normally provided by deck.css on is-deck pages, inlined
     here so this component also works on plain pages (e.g. the case-studies
     overview) without importing deck.css and its colliding .card rules */
  .scene { padding-inline: clamp(16px, 4.5vw, 64px); overflow: clip; }
  .scene--full { min-height: 100svh; display: grid; align-content: center; }
  .scene-inner { width: 100%; max-width: var(--container); margin-inline: auto; }

  /* slide layout: figure one side, copy the other */
  .slide-grid {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(var(--s-6), 5vw, var(--s-10)); align-items: center;
  }
  /* figure is first in source; default puts it on the RIGHT (rtl flip), and
     .is-left keeps natural order so the figure sits on the left */
  .slide-grid:not(.is-left) { direction: rtl; }
  .slide-grid:not(.is-left) > * { direction: ltr; }

  .slide-figure {
    border-radius: var(--radius); overflow: clip; background: var(--surface);
    border: 1px solid var(--line); box-shadow: var(--shadow-lift);
    display: grid; place-items: center; max-height: 72svh;
  }
  .slide-figure img, .slide-figure video {
    width: 100%; height: 100%; max-height: 72svh; object-fit: contain; display: block;
  }
  /* code-built compositions: same soft canvas card, pieces manage themselves */
  .slide-figure--comp {
    max-height: none;
    padding: clamp(var(--s-4), 2.5vw, var(--s-8));
    background: var(--line-soft);
  }

  /* comps that break out of the card: no chrome, pieces float free */
  .comp--grandpa, .comp--personas, .comp--goals, .comp--research, .comp--framework, .comp--capmap, .comp--assist, .comp--redlining, .comp--deck, .comp--conclusion,
  .comp--archetypes2, .comp--workinto, .comp--conclusion2, .comp--research7,
  .comp--activate, .comp--flow, .comp--crm, .comp--duo, .comp--zerotoone, .comp--cardflow, .comp--flowdeck,
  .comp--jdstrike, .comp--jdartifacts, .comp--jdflow,
  .comp--hiabubbles, .comp--hiasupport, .comp--hiaprocess,
  .comp--infinity, .comp--journey, .comp--dotloop, .comp--deescalation {
    background: none; border: none; box-shadow: none;
    padding: 0; margin: 0; border-radius: 0; overflow: visible;
  }
  /* wider figure column for the dense artifacts */
  .slide-grid:has(.comp--goals), .slide-grid:has(.comp--research), .slide-grid:has(.comp--capmap), .slide-grid:has(.comp--redlining), .slide-grid:has(.comp--deck), .slide-grid:has(.comp--conclusion),
  .slide-grid:has(.comp--workinto), .slide-grid:has(.comp--conclusion2), .slide-grid:has(.comp--research7),
  .slide-grid:has(.comp--activate), .slide-grid:has(.comp--crm),
  .slide-grid:has(.comp--jdartifacts), .slide-grid:has(.comp--jdflow),
  .slide-grid:has(.comp--hiabubbles), .slide-grid:has(.comp--hiasupport),
  .slide-grid:has(.comp--journey), .slide-grid:has(.comp--infinity), .slide-grid:has(.comp--deescalation) {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  }
  /* the archetype photos get an even wider column so they can read large */
  .slide-grid:has(.comp--archetypes2), .slide-grid:has(.comp--duo) {
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
  }
  /* the E2E flow / card flow are ultra-wide: whole row, stacked under the copy */
  .slide-grid:has(.comp--flow), .slide-grid:has(.comp--cardflow), .slide-grid:has(.comp--flowdeck) {
    grid-template-columns: 1fr; direction: ltr; gap: clamp(var(--s-5), 3vh, var(--s-8));
  }
  .slide-grid:has(.comp--flow) .slide-figure,
  .slide-grid:has(.comp--cardflow) .slide-figure,
  .slide-grid:has(.comp--flowdeck) .slide-figure { order: 2; }
  /* flowdeck reads bigger: break the diagram wider than the copy column,
     centered on the viewport (capped so it never causes a horizontal scroll) */
  .slide-grid:has(.comp--flowdeck) .slide-figure {
    width: min(94vw, 1400px);
    margin-left: calc(50% - min(47vw, 700px));
  }
  /* "full" layout: headline on top, figure full width beneath */
  .slide-stack { display: grid; gap: clamp(var(--s-4), 3vh, var(--s-6)); }
  .slide-stack .slide-copy { order: -1; }
  .slide-title--full {
    font-family: var(--font-sans); font-weight: 600;
    font-size: clamp(1.15rem, 0.95rem + 1vw, 1.75rem); line-height: 1.3;
    max-width: 62ch;
  }
  .slide-stack .slide-figure { max-height: 62svh; }
  .slide-stack .slide-figure--comp { max-height: none; }

  /* "center" layout: portrait stacked over centered copy */
  .slide-center {
    display: grid; justify-items: center; text-align: center;
    gap: clamp(var(--s-5), 4vh, var(--s-8));
  }
  .slide-center .slide-copy { max-width: 46rem; }
