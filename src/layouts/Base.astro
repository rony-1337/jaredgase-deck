---
import "../styles/global.css";
import DeckChrome from "../components/DeckChrome.astro";
import Footer from "../components/Footer.astro";
import ModeToggle from "../components/ModeToggle.astro";

interface Props {
  title?: string;
  description?: string;
  mode?: string; // current mode slug, gives the header context
  theme?: "light" | "dark";
  header?: boolean;
  footer?: boolean;
  /** optional "Next ->" destination shown in the footer */
  footerNext?: { title: string; href: string };
  bodyClass?: string; // e.g. "is-deck" to enable scroll-snap scenes
}

const {
  title = "Jared Gase",
  description = "Staff product designer. Interview presentation.",
  mode,
  theme = "light",
  header = true,
  footer = true,
  footerNext,
  bodyClass,
} = Astro.props;

const fullTitle =
  title === "Jared Gase" ? "Jared Gase · Staff Product Designer" : `${title} · Jared Gase`;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <!-- mark JS available before paint, so reveal animations can hide their
         start state without risking invisible content when JS is off -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- unlisted on purpose: shared by link, kept out of search -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700&family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    {header && <DeckChrome current={mode} />}
    <main id="main" class:list={[header && "main-offset"]}>
      <slot />
    </main>
    {footer && <Footer next={footerNext} />}
    <ModeToggle />
  </body>
</html>
