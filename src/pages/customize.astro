---
import Base from "../layouts/Base.astro";
import { personas } from "../data/personas";
---

<Base
  mode="customize"
  theme="dark"
  title="Customize"
  description="Build a tailored version of the presentation live, from approved building blocks."
>
  <section class="container cz">
    <p class="eyebrow accent">Live · built on the call</p>
    <h1 class="cz-title">Let's build your version</h1>
    <p class="cz-lede">
      Drop in the company, the role, and the job description. I assemble a tailored
      run of the panel on the spot, branded to you, from work I have already written
      and vetted. You watch it come together.
    </p>

    <!-- input panel -->
    <div class="builder">
      <div class="field-grid">
        <label class="field">
          <span class="field-label">Company</span>
          <input id="cz-company" type="text" placeholder="Where are we interviewing?" />
        </label>

        <label class="field">
          <span class="field-label">Role</span>
          <input id="cz-role" type="text" placeholder="The title on the posting" />
        </label>

        <label class="field">
          <span class="field-label">Date</span>
          <input id="cz-date" type="text" placeholder="e.g. Friday, August 7" />
        </label>

        <label class="field">
          <span class="field-label">Length</span>
          <select id="cz-length">
            <option value="15">15 minutes</option>
            <option value="30" selected>30 minutes</option>
            <option value="45">45 minutes</option>
            <option value="60">60 minutes</option>
          </select>
          <span class="field-hint">More time pulls in more projects.</span>
        </label>

        <label class="field">
          <span class="field-label">Audience</span>
          <select id="cz-audience">
            {personas.map((p) => <option value={p.id}>{p.name}</option>)}
          </select>
          <span class="field-hint">Sets the emphasis.</span>
        </label>
      </div>

      <label class="field">
        <span class="field-label">Job description link</span>
        <input id="cz-jdurl" type="url" placeholder="Greenhouse, Lever, Ashby, or a plain careers page" />
        <span class="field-hint">Works when the text is in the page source. Workday and LinkedIn usually need a paste.</span>
      </label>

      <label class="field">
        <span class="field-label">Or paste the job description</span>
        <textarea id="cz-jdtext" rows="5" placeholder="Paste the full posting here. This always works."></textarea>
      </label>

      <button class="build-btn" id="buildBtn" type="button">Build presentation →</button>
      <p class="build-status" id="buildStatus" role="status" hidden></p>
    </div>

    <!-- what happens -->
    <div class="explain">
      <div class="explain-head">
        <h2 class="explain-title">What happens when you hit build</h2>
        <span class="badge">Local · runs on your machine</span>
      </div>
      <p class="explain-body">
        The job description is read and classified, projects are selected and ranked for
        this role, the framing copy is rewritten to fit the posting, and the run is
        branded to the company — then it opens as a live presentation.
      </p>
      <p class="safety">
        Every number and metric stays exactly as written and vetted. The AI reorders and
        rephrases from work already approved; it never writes a claim or a figure on its
        own — anything ungrounded is reverted to the source automatically.
      </p>
    </div>
  </section>
</Base>

<script>
  // Build handler: POST the form to the local tailor server (proxied at /api),
  // stash the returned spec, and open the tailored run. The API key never
  // touches this page — it lives only in the local server's env.
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement | null;
  const btn = document.getElementById("buildBtn") as HTMLButtonElement | null;
  const status = document.getElementById("buildStatus");

  const setStatus = (msg: string, kind: "busy" | "ok" | "err") => {
    if (!status) return;
    status.hidden = false;
    status.textContent = msg;
    status.dataset.kind = kind;
  };

  btn?.addEventListener("click", async () => {
    const company = $("cz-company")?.value.trim() ?? "";
    const role = $("cz-role")?.value.trim() ?? "";
    const date = $("cz-date")?.value.trim() ?? "";
    const durationMin = Number($("cz-length")?.value) || 30;
    const audience = $("cz-audience")?.value ?? "panel";
    const jdUrl = $("cz-jdurl")?.value.trim() ?? "";
    const jdText = ($("cz-jdtext") as unknown as HTMLTextAreaElement | null)?.value.trim() ?? "";

    if (!company || !role) { setStatus("Add the company and role first.", "err"); return; }
    if (jdText.length < 40 && !jdUrl) { setStatus("Paste the job description (or add a link).", "err"); return; }

    btn.disabled = true;
    setStatus("Reading the job description and tailoring the run… (~10–15s)", "busy");
    try {
      const res = await fetch("/api/tailor", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ company, role, date, durationMin, audience, jdUrl, jdText }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || `Request failed (${res.status})`);
      sessionStorage.setItem("tailorSpec", JSON.stringify(data));
      setStatus(`Built ${data.projects.length} project scenes. Opening your run…`, "ok");
      location.href = "/tailored";
    } catch (err: any) {
      setStatus(
        `${err?.message || err}  ·  Is the tailor server running? (npm run serve:tailor)`,
        "err",
      );
      btn.disabled = false;
    }
  });
</script>

<style>
  .cz {
    padding-block: var(--s-10) var(--s-12);
    max-width: 52rem;
  }
  .cz-title {
    font-size: var(--t-h1);
    margin-top: var(--s-4);
  }
  .cz-lede {
    margin-top: var(--s-5);
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .builder {
    margin-top: var(--s-8);
    display: grid;
    gap: var(--s-5);
    padding: var(--s-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .field-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--s-5);
  }
  .field {
    display: grid;
    gap: var(--s-2);
  }
  .field-label {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    color: var(--ink);
    font: inherit;
    font-size: var(--t-small);
  }
  .field textarea {
    resize: vertical;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--ink-faint);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
  }
  .field-hint {
    font-size: var(--t-label);
    color: var(--ink-faint);
    line-height: 1.4;
  }

  .build-btn {
    justify-self: start;
    margin-top: var(--s-2);
    padding: 0.8rem 1.4rem;
    background: var(--accent);
    color: #fff;
    border: 0;
    border-radius: var(--radius-s);
    font-weight: 600;
    font-size: var(--t-small);
    transition: transform 0.15s var(--ease), filter 0.15s var(--ease);
  }
  .build-btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
  }
  .build-btn:disabled { opacity: 0.6; cursor: default; transform: none; filter: none; }
  .build-status {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    line-height: 1.45;
  }
  .build-status[data-kind="busy"] { color: var(--ink-soft); }
  .build-status[data-kind="ok"] { color: var(--accent-ink); }
  .build-status[data-kind="err"] { color: #e06666; }

  .explain {
    margin-top: var(--s-10);
  }
  .explain-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-bottom: var(--s-3);
  }
  .explain-title {
    font-size: var(--t-h3);
  }
  .badge {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.04em;
    color: var(--accent-ink);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--line));
    border-radius: 999px;
    padding: 3px 10px;
  }
  .explain-body {
    color: var(--ink-soft);
    max-width: 56ch;
    line-height: 1.55;
  }

  .log {
    margin-top: var(--s-5);
    padding: var(--s-5);
    background: #090c12;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow-x: auto;
    min-height: 18rem;
  }
  .log code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: #aeb9ca;
    white-space: pre;
  }
  .safety {
    margin-top: var(--s-5);
    padding-left: var(--s-4);
    border-left: 2px solid var(--accent);
    color: var(--ink);
    font-size: var(--t-small);
    line-height: 1.55;
    max-width: 56ch;
  }
</style>
