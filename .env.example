# Customize generator — local environment variables.
# Copy to .env.local (git-ignored) for local use. NEVER commit real values.

# Anthropic API key — used only by the local tailor server (scripts/serve-tailor.ts).
# Set a monthly SPEND LIMIT on this key in the Anthropic console as a safety net.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: generation effort (low | medium | high). Lower = faster/cheaper.
CUSTOMIZE_EFFORT=medium
